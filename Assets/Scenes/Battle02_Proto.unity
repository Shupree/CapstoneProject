    memoText: "\uBA54\uB9AC\uAC00 \uCE7C\uC774\uB098 \uB3C4\uB07C\uAC19\uC740 \uD749\uAE30\uB97C
      \uB4E4\uACE0 \uC788\uC744 \uB54C\uC5D0\uB294 \uAC15\uB839\uC220\uC744 \uD558\uB294
