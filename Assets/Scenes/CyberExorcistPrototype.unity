    - "\u2026\uB098 \uBCF4\uC774\uB294 \uAC70\uC57C?\n\uCE74\uBA54\uB77C \uB4A4\uC5D0
      \uC228\uC5B4 \uC788\uC5C8\uB294\uB370."
    - "\uC608\uC804 \uC77C\uC740 \uAE30\uC5B5 \uC548 \uB098. \uADF8\uB0E5 \uC2EC\uC2EC\uD588\uC5B4.\n\uB0A8\uB4E4
      \uC77C\uC0C1\uC744 \uAD6C\uACBD\uD558\uB294 \uAC8C \uC88B\uC558\uAC70\uB4E0\u2026"
    - "\uC131\uBD88\uD558\uB294 \uBC95\uB3C4 \uBAB0\uB790\uC5B4.\n\uC54C\uB824\uC8FC\uBA74
      \uC774\uC81C \uAC08\uAC8C."
  GhostChoice:
    Label: {fileID: 805867781}
    Values:
    - "\uB300\uD654 \uC2DC\uB3C4\uD558\uAE30"
    - "\uC65C \uC0AC\uB78C\uB4E4\uC744 \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uC5C8\uC5B4?"
    - "\uC774\uC81C \uADF8\uB9CC\uD558\uACE0, \uB5A0\uB098\uB294 \uAC74 \uC5B4\uB54C?"
    - "\uC131\uBD88\uC744 \uB3C4\uC640\uC900\uB2E4"
    - "\uADC0\uC2E0\uC744 \uBC30\uC6C5\uD558\uB294 \uC911\u2026"
  GhostNext: {fileID: 1248921327}
  PendingSteps:
  - {fileID: 549642961}
  - {fileID: 549303894}
  - {fileID: 2146494877}
  - {fileID: 1687275806}
  - {fileID: 918996783}
  DoneSteps:
  - {fileID: 1413573223}
  - {fileID: 1552481879}
  - {fileID: 132824564}
  - {fileID: 1291178498}
  - {fileID: 1039574783}
  CaseStatus:
    Label: {fileID: 509042086}
    Values:
    - "\uC870\uC0AC \uC911 \xB7 \uC758\uB8B0\uC778 \uBBFC\uC11C"
    - "\uC885\uACB0 \xB7 \uC794\uB958 \uC2E0\uD638 \uC5C6\uC74C"
  CollectedKeywords:
    Label: {fileID: 1694274135}
    Values:
    - "\uC544\uC9C1 \uC218\uC9D1\uB41C \uD0A4\uC6CC\uB4DC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    - "\uAD00\uC74C\uC99D / \uADC0\uC2E0"
  ClueSummary:
    Label: {fileID: 1232139842}
    Values:
    - "\uBA54\uC77C\uACFC \uAC8C\uC2DC\uAE00\uC758 \uC99D\uC0C1\uC744\n\uB300\uC870\uD574
      \uC5F0\uACB0\uC810\uC744 \uCC3E\uC73C\uC138\uC694."
    - "\uC790\uB3D9 \uB179\uD654 + \uB208\uB3D9\uC790 \uC544\uC774\uCF58\n\uC758\uB8B0\uC778\uACFC
      \uAC19\uC740 \uC99D\uC0C1 \uD655\uC778"
    - "\uC790\uB3D9 \uB179\uD654 + \uB208\uB3D9\uC790 \uC544\uC774\uCF58\n\uCD2C\uC601\uB3C4\uAD6C
      \uB4A4\uC5D0 \uC228\uC740 \uC874\uC7AC"
  Goal:
    Label: {fileID: 551909510}
    Values:
    - "\uD604\uC7AC \uBAA9\uD45C  /  \uBA54\uC77C\uC758 \uC5F0\uB77D\uCC98\uB97C
      \uCD94\uAC00\uD558\uC138\uC694."
    - "\uD604\uC7AC \uBAA9\uD45C  /  \uBBFC\uC11C\uC640 \uB300\uD654\uD574 \uB2E8\uC11C\uB97C
      \uC5BB\uC73C\uC138\uC694."
    - "\uD604\uC7AC \uBAA9\uD45C  /  \uD0A4\uC6CC\uB4DC\uB97C \uC870\uD569\uD574
      \uAD34\uB2F4 \uAE30\uB85D\uC744 \uC870\uC0AC\uD558\uC138\uC694."
    - "\uD604\uC7AC \uBAA9\uD45C  /  \uBB38\uC81C\uC758 \uC0AC\uC774\uD2B8\uC5D0\uC11C
      \uCD2C\uC601\uB3C4\uAD6C\uB97C \uCE58\uC6B0\uC138\uC694."
    - "\uD604\uC7AC \uBAA9\uD45C  /  \uADC0\uC2E0\uC758 \uC774\uC57C\uAE30\uB97C
      \uB4E3\uACE0 \uC131\uBD88\uC744 \uB3C4\uC640\uC8FC\uC138\uC694."
    - "\uD604\uC7AC \uBAA9\uD45C  /  \uC758\uB8B0 \uD574\uACB0. \uBBFC\uC11C\uC758
      \uB2F5\uC7A5\uC744 \uD655\uC778\uD558\uC138\uC694."
