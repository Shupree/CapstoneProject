    memoText: "\uBA54\uB9AC\uB294 '\uB124 \uC544\uAE30\uB294 \uC8FD\uC9C0 \uC54A\uC558\uC5B4'
      \uB77C\uB294 \uB9D0\uC5D0 \uD76C\uB9DD\uC744 \uAC16\uB294\uB2E4"
  - id: mary_weapon
    optional: 0
    excludeFromMemo: 0
    memoText: "\uCE7C\uC744 \uB4E0 \uBA54\uB9AC\uAC00 \uB098\uD0C0\uB09C\uB2E4\uBA74
      \uC989\uC2DC \uD1B5\uD654\uB97C \uC885\uB8CC\uD560 \uAC83."
  - id: mary_forbidden
    optional: 0
    excludeFromMemo: 0
    memoText: "\u2018\uB124 \uC544\uC774\uB294 \uB0B4\uAC00 \uC8FD\uC600\uC5B4\u2019\uB77C\uB294
      \uB9D0\uC744 \uD558\uC9C0 \uB9D0 \uAC83."
  - id: mary_curse
    optional: 0
    excludeFromMemo: 0
    memoText: "\uBA54\uB9AC\uAC00 \uB2F9\uC2E0\uC744 \uC6A9\uC11C\uD558\uC9C0 \uC54A\uC744
      \uAC83\uC774\uB2E4."
  - id: mary_comment
    optional: 0
    excludeFromMemo: 1
    memoText: "seoyeon041\uC740 \uAE08\uC9C0\uB41C \uB9D0\uC758 \uBD80\uC791\uC6A9\uC744
      \uBB3B\uACE0, \uC624\uB298 \uCE5C\uAD6C\uC5D0\uAC8C \uD574 \uBCF4\uACA0\uB2E4\uB294
      \uB313\uAE00\uC744 \uB0A8\uACBC\uB2E4."
  - id: mary_spouse
    optional: 1
    excludeFromMemo: 0
    memoText: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220\uC740 \uBBF8\uB798\uC758
      \uBC30\uC6B0\uC790\uB97C \uC54C \uC218 \uC788\uB2E4\uACE0 \uC18C\uAC1C\uB418\uC5B4
      \uC788\uB2E4."
