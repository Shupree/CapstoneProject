  heroineCallImageId: Heroine_1
  siyulCallImageId: Client_1
  heroineCallSprite: {fileID: -1587681010093017276, guid: 40e472643562b5847aaf89d2224dc0db, type: 3}
  siyulCallSprite: {fileID: 8447392308922861121, guid: aaee4f8164d951e41a1b1fc780c908f6, type: 3}
  callPortraits: {fileID: 38694935}
  siteEntries:
  - category: "\uAD34\uB2F4 \uAC8C\uC2DC\uD310"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAD34\uB2F4, \uC815\uB9D0\uC77C\uAE4C?"
    summary: "\uAC70\uC6B8 \uC55E\uC5D0\uC11C \uC774\uB984\uC744 \uBD80\uB978\uB2E4\uB294
      \uC720\uBA85\uD55C \uB3C4\uC2DC \uAD34\uB2F4"
    article: "\uC774 \uAC8C\uC2DC\uD310\uC5D0\uB3C4 \uBE14\uB7EC\uB514 \uBA54\uB9AC
      \uC774\uC57C\uAE30\uAC00 \uC790\uC8FC \uC62C\uB77C\uC628\uB2E4. \uAC70\uC6B8
      \uC55E\uC5D0\uC11C \uC774\uB984\uC744 \uBD80\uB978\uB2E4\uB294 \uC904\uAC70\uB9AC\uB294
      \uAC19\uC9C0\uB9CC, \uBAA9\uACA9\uD55C \uBAA8\uC2B5\uC774\uB098 \uADF8 \uB4A4\uC5D0
      \uC77C\uC5B4\uB09C \uC77C\uC740 \uAE00\uB9C8\uB2E4 \uB2E4\uB974\uB2E4.\n\n\uC5B4\uB5A4
      \uAE00\uC740 \uC758\uC2DD\uC744 \uD55C \uC0AC\uB78C\uC5D0\uAC8C, \uC5B4\uB5A4
      \uAE00\uC740 \uAC70\uC6B8\uC744 \uB4E4\uC5EC\uB2E4\uBCF8 \uC0AC\uB78C\uC5D0\uAC8C
      \uC77C\uC774 \uC0DD\uACBC\uB2E4\uACE0 \uD55C\uB2E4. \uADF8\uB0E5 \u2018\uBB34\uC11C\uC6B4
      \uC774\uC57C\uAE30\u2019\uB85C \uB118\uAE30\uAE30\uC5D0\uB294 \uC11C\uB85C
      \uACB9\uCE58\uB294 \uAE30\uB85D\uC774 \uB9CE\uB2E4.\n\n\uAD00\uB828 \uAE00\uC744
      \uC77D\uC744 \uB54C\uB294 \uBA54\uB9AC\uC758 \uBAA8\uC2B5, \uD589\uB3D9, \uBC18\uC751\uC744
      \uB530\uB85C \uC815\uB9AC\uD574 \uBCF4\uC790. \uD769\uC5B4\uC9C4 \uC774\uC57C\uAE30\uB97C
      \uBE44\uAD50\uD558\uBA74 \uACF5\uD1B5\uC810\uC744 \uCC3E\uC744 \uC218 \uC788\uC744
      \uAC83\uC774\uB2E4."
    button: {fileID: 1369764134}
  - category: "\uAD34\uB2F4 \uAC8C\uC2DC\uD310"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220 \uD558\uB294 \uBC29\uBC95"
    summary: "\uC61B\uB0A0\uC5D0 \uC720\uD589\uD588\uB358 \uAC15\uB839 \uC758\uC2DD\uACFC
      \uADF8 \uC720\uB798"
    article: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220\uC5D0 \uAD00\uD55C
      \uC624\uB798\uB41C \uAE00\uB4E4\uC744 \uBAA8\uC558\uB2E4. \uC774\uB984\uC744
      \uBD80\uB974\uB294 \uD69F\uC218\uB098 \uC900\uBE44\uBB3C\uC740 \uAE30\uB85D\uB9C8\uB2E4
      \uB2EC\uB77C, \uC774 \uAE00\uC5D0\uC11C\uB294 \uC758\uC2DD \uB4A4\uC5D0 \uB098\uD0C0\uB09C
      \uD604\uC0C1\uC5D0 \uC9D1\uC911\uD55C\uB2E4.\n\n\uBAA9\uACA9\uB2F4\uC5D0\uC11C
      \uD2B9\uD788 \uBC18\uBCF5\uB418\uB294 \uAC83\uC740 \uAC70\uC6B8 \uC18D \uBA54\uB9AC\uC758
      \uC190\uC5D0 \uB4E4\uB9B0 \uBB3C\uAC74\uC774\uC5C8\uB2E4. \uC544\uBB34\uAC83\uB3C4
      \uB4E4\uC9C0 \uC54A\uC558\uB2E4\uB294 \uAE00\uB3C4 \uC788\uC5C8\uC9C0\uB9CC,
      \uBB34\uC5B8\uAC00 \uB4E4\uACE0 \uB098\uD0C0\uB0AC\uB2E4\uB294 \uAE00\uB4E4\uC740
      \uACB0\uB9D0\uC774 \uBE44\uC2B7\uD588\uB2E4.\n\n<link=\"mary_weapon\">\uBA54\uB9AC\uAC00
      \uCE7C\uC774\uB098 \uB3C4\uB07C\uAC19\uC740 \uD749\uAE30\uB97C \uB4E4\uACE0
      \uC788\uC744 \uB54C\uC5D0\uB294 \uAC15\uB839\uC220\uC744 \uD558\uB294 \uC8FC\uCCB4\uC5D0\uAC8C
      \uC704\uD574\uAC00 \uAC00\uD574\uC84C\uB2E4.</link>\n\n\uC758\uC2DD\uC758 \uBC29\uC2DD\uB9CC
      \uD655\uC778\uD558\uACE0 \uC774 \uB300\uBAA9\uC744 \uB193\uCE5C \uC0AC\uB78C\uB4E4\uC774
      \uB9CE\uC558\uB2E4. \uBA54\uB9AC\uAC00 \uB098\uD0C0\uB0AC\uB2E4\uBA74 \uBB34\uC5C7\uC744
      \uB4E4\uACE0 \uC788\uB294\uC9C0\uBD80\uD130 \uC0B4\uD3B4\uBCFC \uD544\uC694\uAC00
      \uC788\uB2E4."
    button: {fileID: 478300121}
  - category: "\uBE14\uB85C\uADF8"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC (\uBBF8\uAD6D\uAD34\uB2F4)"
    summary: "\uBA54\uB9AC\uB97C \uC18C\uD658\uD574 \uB098\uD0C0\uB098\uAC8C \uB418\uBA74
      \uC790\uC2E0\uC744 \uBD80\uB978 \uC0AC\uB78C\uC744 \uC8FD\uC778\uB2E4\uACE0
      \uD569\uB2C8\uB2E4."
    article: "\uBE14\uB7EC\uB514 \uBA54\uB9AC\uB77C\uB294 \uC774\uB984\uC73C\uB85C
      \uC804\uD574\uC9C0\uB294 \uC774\uC57C\uAE30\uC5D0\uB294 \uC5EC\uB7EC \uBAA8\uC2B5\uC758
      \uC5EC\uC778\uC774 \uB4F1\uC7A5\uD55C\uB2E4. \uADF8\uC911 \uD55C \uC804\uC2B9\uC5D0\uC11C\uB294
      \uC5EC\uC778\uC774 \uD145 \uBE48 \uC694\uB78C \uC55E\uC744 \uB5A0\uB098\uC9C0
      \uBABB\uD588\uB2E4\uACE0 \uD55C\uB2E4.\n\n\uC544\uC774\uB97C \uC548\uB4EF\uC774
      \uD5C8\uACF5\uC744 \uB04C\uC5B4\uC548\uAC70\uB098, \uB204\uAD70\uAC00\uB97C
      \uC7AC\uC6B0\uB294 \uB4EF\uD55C \uB178\uB7AB\uC18C\uB9AC\uB97C \uB0C8\uB2E4\uB294
      \uAE30\uB85D\uB3C4 \uB0A8\uC544 \uC788\uB2E4.\n\n<link=\"mary_child\">\uACFC\uAC70
      \uC8FD\uC740 \uC544\uAE30\uB97C \uADF8\uB9AC\uC6CC\uD558\uACE0 \uC788\uB2E4.</link>\n\n\uC774
      \uC804\uC2B9\uC758 \uBA54\uB9AC\uB294 \uB2E8\uC21C\uD788 \uAC70\uC6B8\uC744
      \uB5A0\uB3C4\uB294 \uD615\uCCB4\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uC783\uC5B4\uBC84\uB9B0
      \uB204\uAD70\uAC00\uB97C \uACC4\uC18D \uCC3E\uACE0 \uC788\uB2E4\uB294 \uB300\uBAA9\uC774
      \uB2E4\uB978 \uAE30\uB85D\uACFC \uAD6C\uBCC4\uB41C\uB2E4."
    button: {fileID: 627332760}
  - category: "\uB3C4\uC2DC\uC804\uC124 \uC544\uCE74\uC774\uBE0C"
    title: "\uAC70\uC6B8 \uC18D \uC774\uB984\uC744 \uBD80\uB974\uB294 \uC758\uC2DD"
    summary: "\uCD1B\uBD88\uACFC \uAC70\uC6B8\uC744 \uC0AC\uC6A9\uD558\uB294 \uAC15\uB839\uD68C\uC5D0
      \uB300\uD55C \uAE30\uB85D"
    article: "\uB0A1\uC740 \uC758\uC2DD \uAE30\uB85D\uC758 \uC5EC\uBC31\uC5D0\uB294
      \uC774\uB984\uC744 \uBD80\uB974\uB294 \uC808\uCC28\uBCF4\uB2E4, \uBA54\uB9AC\uAC00
      \uB098\uD0C0\uB09C \uB4A4 \uC624\uAC04 \uB9D0\uC774 \uB354 \uC790\uC138\uD788
      \uC801\uD600 \uC788\uC5C8\uB2E4. \uCC98\uC74C\uC5D0\uB294 \uC5B4\uB5A4 \uBB3C\uC74C\uC5D0\uB3C4
      \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4\uACE0 \uD55C\uB2E4.\n\n\uADF8\uB7EC\uB098
      \uD55C \uBB38\uC7A5\uB9CC\uC740 \uBC18\uC751\uC744 \uBC14\uAFB8\uC5C8\uB2E4.
      \uAE00\uC4F4\uC774\uB294 \uADF8 \uB9D0\uC744 \uB4E3\uC790 \uBA54\uB9AC\uC758
      \uC6C0\uC9C1\uC784\uC774 \uBA4E\uACE0, \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB9B0
      \uCABD\uC73C\uB85C \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4\uACE0 \uAE30\uB85D\uD588\uB2E4.\n\n<link=\"mary_words\">\"\uB124
      \uC544\uAE30\uB294 \uC8FD\uC9C0 \uC54A\uC558\uC5B4.\"\uB77C\uB294 \uB9D0\uC5D0
      \uAE30\uC774\uD55C \uBC18\uC751\uC744 \uBCF4\uC778\uB2E4.</link>\n\n\uB4B7\uBD80\uBD84\uC740
      \uCC22\uACA8 \uC788\uC5B4 \uADF8 \uB2E4\uC74C\uC5D0 \uC5B4\uB5A4 \uC77C\uC774
      \uC788\uC5C8\uB294\uC9C0\uB294 \uC54C \uC218 \uC5C6\uB2E4. \uB2E4\uB9CC \uC774
      \uBB38\uC7A5\uC5D0\uB294 \uC5EC\uB7EC \uBC88 \uBC11\uC904\uC774 \uADF8\uC5B4\uC838
      \uC788\uC5C8\uB2E4."
    button: {fileID: 193249308}
  - category: "\uAD34\uB2F4 \uAC8C\uC2DC\uD310"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uACBD\uD5D8\uB2F4"
    summary: "\uC758\uC2DD\uC744 \uD55C \uB4A4 \uC774\uC0C1\uD55C \uC77C\uC744 \uACAA\uC5C8\uB2E4\uB294
      \uC774\uC57C\uAE30"
    article: "\uCC98\uC74C\uC5D4 \uCE5C\uAD6C\uAC00 \uC7A5\uB09C\uC744 \uCE58\uB294
      \uC904 \uC54C\uC558\uB2E4. \uAC15\uB839\uD68C\uAC00 \uB05D\uB0AC\uB294\uB370\uB3C4
      \uD63C\uC790 \uB0A8\uC544 \uAC70\uC6B8\uC744 \uBCF4\uACE0 \uC788\uC5C8\uACE0,
      \uB9D0\uC744 \uAC78\uC5B4\uB3C4 \uD55C\uCC38 \uB4A4\uC5D0\uC57C \uB3CC\uC544\uBD24\uB2E4.\n\n\uB2E4\uC74C
      \uB0A0\uBD80\uD130 \uD3C9\uC18C\uC640 \uB2E4\uB978 \uB9D0\uD22C\uB97C \uC4F0\uAE30
      \uC2DC\uC791\uD588\uB2E4. \uC0AC\uC9C4 \uC18D \uC790\uAE30 \uC5BC\uAD74\uC744
      \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF4\uB294 \uAC83\uB3C4 \uC774\uC0C1\uD588\uB2E4.\n\n\uC774
      \uAE00\uC744 \uC4F0\uB294 \uC9C0\uAE08\uB3C4 \uADF8\uB0A0 \uB4E4\uC5C8\uB358
      \uB178\uB7AB\uC18C\uB9AC\uAC00 \uAE30\uC5B5\uB09C\uB2E4. \uB2E4\uB978 \uC0AC\uB78C\uB3C4
      \uBE44\uC2B7\uD55C \uC77C\uC744 \uACAA\uC5C8\uB2E4\uBA74 \uB2F9\uC2DC \uC0C1\uD669\uC744
      \uC790\uC138\uD788 \uB0A8\uACA8 \uC8FC\uC5C8\uC73C\uBA74 \uD55C\uB2E4."
    button: {fileID: 600308813}
  - category: "\uAD34\uB2F4 \uC704\uD0A4"
    title: "\uAC70\uC6B8 \uAD34\uB2F4\uC758 \uC9C0\uC5ED\uBCC4 \uC804\uC2B9"
    summary: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uC774\uC57C\uAE30\uC758 \uB2E4\uB978
      \uD615\uD0DC\uB97C \uC815\uB9AC\uD588\uC2B5\uB2C8\uB2E4."
    article: "\uC9C0\uC5ED\uBCC4 \uAC70\uC6B8 \uAD34\uB2F4\uC744 \uBE44\uAD50\uD558\uB2E4
      \uBCF4\uBA74, \uC774\uB984\uC744 \uBD80\uB978 \uC0AC\uB78C\uACFC \uBA54\uB9AC\uB97C
      \uB9C8\uC8FC\uBCF8 \uC0AC\uB78C\uC774 \uC11C\uB85C \uB2E4\uB978 \uACBD\uC6B0\uAC00
      \uB098\uC628\uB2E4. \uC774 \uB458\uC744 \uAC19\uC740 \uC0AC\uB78C\uC73C\uB85C
      \uC0DD\uAC01\uD558\uBA74 \uAE30\uB85D\uC758 \uC55E\uB4A4\uAC00 \uB9DE\uC9C0
      \uC54A\uB294\uB2E4.\n\n\uD55C \uC804\uC2B9\uC740 \uC800\uC8FC\uAC00 \uB204\uAD6C\uC5D0\uAC8C
      \uC62E\uACA8 \uAC00\uB294\uC9C0 \uB2E4\uC74C\uACFC \uAC19\uC774 \uC124\uBA85\uD55C\uB2E4.\n\n<link=\"mary_reflection\">\uBA54\uB9AC\uAC00
      \uB9C8\uC8FC\uBCF8 \uC790\uB294 \uC800\uC8FC\uC5D0 \uAC78\uB9B0\uB2E4.</link>\n\n\uB0A8\uACA8\uC9C4
      \uC0BD\uD654\uC5D0\uB294 \uC0AC\uB78C\uACFC \uAC70\uC6B8\uC758 \uC704\uCE58\uAC00
      \uD45C\uC2DC\uB418\uC5B4 \uC788\uC5C8\uB2E4. \uC800\uC8FC\uB97C \uC774\uD574\uD558\uB824\uBA74
      \uB204\uAC00 \uB204\uAD6C\uB97C \uBCF4\uACE0 \uC788\uC5C8\uB294\uC9C0\uB97C
      \uC0B4\uD3B4\uC57C \uD560 \uAC83 \uAC19\uB2E4."
    button: {fileID: 1193626886}
  - category: "\uC81C\uBCF4 \uAC8C\uC2DC\uD310"
    title: "\uCE5C\uAD6C\uAC00 \uAC15\uB839\uD68C \uB4A4 \uB2EC\uB77C\uC84C\uC5B4\uC694"
    summary: "\uAC15\uB839\uD68C \uB4A4 \uCE5C\uAD6C\uAC00 \uB2EC\uB77C\uC84C\uB2E4\uB294
      \uC775\uBA85 \uC81C\uBCF4"
    article: "\uCE5C\uAD6C\uB4E4\uACFC \uAC70\uC6B8 \uAD34\uB2F4\uC744 \uB530\uB77C
      \uD55C \uB4A4\uBD80\uD130 \uD55C \uCE5C\uAD6C\uAC00 \uC774\uC0C1\uD574\uC84C\uC5B4\uC694.
      \uCC98\uC74C\uC5D0\uB294 \uBCC4\uC77C \uC544\uB2CC \uC904 \uC54C\uC558\uB294\uB370,
      \uC774\uC81C\uB294 \uC800\uD76C\uB97C \uC54C\uC544\uBCF4\uC9C0 \uBABB\uD558\uB294
      \uAC83 \uAC19\uC544\uC694.\n\n\uAC00\uB054\uC740 \uCC98\uC74C \uB4E3\uB294
      \uBAA9\uC18C\uB9AC\uB85C \uB9D0\uC744 \uD574\uC694. \uBB34\uC2A8 \uB9D0\uC744
      \uD558\uB294\uC9C0\uB294 \uC81C\uB300\uB85C \uBABB \uB4E4\uC5C8\uC5B4\uC694.
      \uAC15\uB839\uD68C \uB54C \uBD24\uB358 \uAE00\uC744 \uB2E4\uC2DC \uCC3E\uC73C\uB824\uACE0
      \uD574\uB3C4 \uBE44\uC2B7\uD55C \uC81C\uBAA9\uC774 \uB108\uBB34 \uB9CE\uB124\uC694.\n\n\uB2F9\uC2DC
      \uCE5C\uAD6C\uAC00 \uBB34\uC5C7\uC744 \uBD24\uB294\uC9C0, \uBB34\uC2A8 \uB9D0\uC744
      \uB4E4\uC5C8\uB294\uC9C0\uBD80\uD130 \uAE30\uC5B5\uC744 \uB9DE\uCDB0 \uBCF4\uB824
      \uD569\uB2C8\uB2E4. \uAC19\uC740 \uC758\uC2DD\uC744 \uD588\uB358 \uC0AC\uB78C\uB4E4\uC758
      \uAE30\uB85D\uC744 \uCC3E\uACE0 \uC788\uC5B4\uC694."
    button: {fileID: 386756292}
