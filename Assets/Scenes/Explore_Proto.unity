      \uB4E4\uACE0 \uC788\uC744 \uB54C\uC5D0\uB294 \uAC15\uB839\uC220\uC744 \uD558\uB294
      \uC8FC\uCCB4\uC5D0\uAC8C \uC704\uD574\uAC00 \uAC00\uD574\uC84C\uB2E4."
  - id: mary_child
    memoText: "\uACFC\uAC70 \uC8FD\uC740 \uC544\uAE30\uB97C \uADF8\uB9AC\uC6CC\uD558\uACE0
      \uC788\uB2E4."
  - id: mary_words
    memoText: "\"\uB124 \uC544\uAE30\uB294 \uC8FD\uC9C0 \uC54A\uC558\uC5B4.\"\uB77C\uB294
      \uB9D0\uC5D0 \uAE30\uC774\uD55C \uBC18\uC751\uC744 \uBCF4\uC778\uB2E4."
  - id: mary_reflection
    memoText: "\uBA54\uB9AC\uAC00 \uB9C8\uC8FC\uBCF8 \uC790\uB294 \uC800\uC8FC\uC5D0
      \uAC78\uB9B0\uB2E4.\n(\uADF8\uB807\uB2E4\uBA74 \uBA54\uB9AC\uAC00 \uBA54\uB9AC\uB97C
      \uBCF8\uB2E4\uBA74 \uC5B4\uB5BB\uAC8C \uB420\uAE4C?)"
