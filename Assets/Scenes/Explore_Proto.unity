  clues:
  - id: mary_weakness
    optional: 0
    excludeFromMemo: 0
    memoText: "\uBA54\uB9AC\uB294 \u2018\uB124 \uC544\uC774\uB294 \uC8FD\uC9C0 \uC54A\uC558\uC5B4\u2019\uB77C\uB294
      \uB9D0\uC744 \uB4E4\uC73C\uBA74 \uBD84\uB178\uB97C \uAC70\uB450\uACE0 \uADC0\uB97C
      \uAE30\uC6B8\uC778\uB2E4\uACE0 \uD55C\uB2E4."
  - id: mary_weapon
    optional: 0
    excludeFromMemo: 0
    memoText: "\uCE7C\uC744 \uB4E0 \uBA54\uB9AC\uAC00 \uB098\uD0C0\uB09C\uB2E4\uBA74
      \uC989\uC2DC \uD1B5\uD654\uB97C \uC885\uB8CC\uD560 \uAC83."
  - id: mary_forbidden
    optional: 0
    excludeFromMemo: 0
    memoText: "\u2018\uB124 \uC544\uC774\uB294 \uB0B4\uAC00 \uC8FD\uC600\uC5B4\u2019\uB77C\uB294
      \uB9D0\uC744 \uD558\uC9C0 \uB9D0 \uAC83."
  - id: mary_curse
    optional: 0
    excludeFromMemo: 0
    memoText: "\uBA54\uB9AC\uAC00     \uB2F9\uC2E0\uC744     \uBD99\uC7A1\uC2B5\uB2C8\uB2E4"
  - id: mary_comment
    optional: 0
    excludeFromMemo: 1
    memoText: "seoyeon041: \uC800 \uC774\uC0C1\uD55C \uD654\uBA74\uC774\uB791 \uC18C\uB9AC
      \uB098\uC624\uB294 \uAC70\uC694. \uC800 \uB9D0 \uD55C \uC0AC\uB78C\uC774 \uC544\uB2C8\uB77C
      \uBC30\uC6B0\uC790 \uCC3E\uAE30 \uD558\uB294 \uC0AC\uB78C\uD55C\uD14C \uB098\uC624\uB294
      \uAC70\uC8E0?"
  - id: mary_spouse
    optional: 1
    excludeFromMemo: 0
    memoText: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220\uC740 \uBBF8\uB798\uC758
      \uBC30\uC6B0\uC790\uB97C \uC54C \uC218 \uC788\uB2E4\uACE0 \uC18C\uAC1C\uB418\uC5B4
      \uC788\uB2E4."
