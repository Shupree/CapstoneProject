  callConnection: {fileID: 38694939}
  embeddedWindowDrag: {fileID: 734336940}
  openingMessages:
  - {fileID: 1946653961}
  - {fileID: 1859456037}
  - {fileID: 1939887909}
  openingMessageGap: 0.7
  siteEntries:
  - category: "\uD55C \uC794 \uC0AC\uC804 \xB7 \uC74C\uB8CC"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC\uB294 \uC5B4\uB5A4 \uCE75\uD14C\uC77C\uC77C\uAE4C?"
    summary: "\uD1A0\uB9C8\uD1A0 \uC8FC\uC2A4\uC640 \uD5A5\uC2E0\uB8CC\uAC00 \uB4E4\uC5B4\uAC00\uB294
      \uBD89\uC740 \uCE75\uD14C\uC77C \uC18C\uAC1C."
    article: "\uC791\uC131\uC790 : \uC794\uC758\uAE30\uB85D\n\n\uBE14\uB7EC\uB514
      \uBA54\uB9AC\uB294 \uBCF4\uB4DC\uCE74\uC5D0 \uD1A0\uB9C8\uD1A0 \uC8FC\uC2A4\uC640
      \uB808\uBAAC\uC999\uC744 \uB354\uD558\uB294 \uCE75\uD14C\uC77C\uC774\uB2E4.
      \uB2EC\uCF64\uD55C \uACFC\uC77C \uD5A5\uC744 \uC608\uC0C1\uD558\uACE0 \uB9C8\uC168\uB2E4\uBA74
      \uC9ED\uC9E4\uD558\uACE0 \uB9E4\uCF64\uD55C \uB9DB\uC5D0 \uB180\uB784 \uC218\uB3C4
      \uC788\uB2E4.\n\n\uC6B0\uC2A4\uD130\uC18C\uC2A4, \uD6C4\uCD94, \uC140\uB7EC\uB9AC
      \uC18C\uAE08 \uAC19\uC740 \uC7AC\uB8CC\uAC00 \uD48D\uBBF8\uB97C \uB354\uD55C\uB2E4.
      \uC140\uB7EC\uB9AC\uB098 \uB808\uBAAC \uC870\uAC01\uC744 \uACC1\uB4E4\uC774\uAE30\uB3C4
      \uD55C\uB2E4. \uBD89\uC740 \uC0C9\uB9CC \uBCF4\uACE0 \uB538\uAE30 \uB9DB\uC744
      \uC0C1\uC0C1\uD588\uB2E4\uBA74 \uBA54\uB274 \uC124\uBA85\uC744 \uBA3C\uC800
      \uC77D\uC5B4 \uBCF4\uC790.\n\n\uB313\uAE00\n\uD1A0\uB9C8\uD1A0\uD3B8 : \uC774\uB984\uBCF4\uB2E4
      \uC7AC\uB8CC\uAC00 \uD6E8\uC52C \uCE5C\uC219\uD558\uB124\uC694.\n\uAE34\uC2A4\uD47C
      : \uC800\uB294 \uB2EC\uC9C0 \uC54A\uC740 \uCABD\uC774 \uC88B\uC544\uC11C \uC798
      \uB9DE\uC558\uC5B4\uC694."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC"
    openDialogueSceneId: 
    button: {fileID: 1369764134}
  - category: "\uC8FC\uB9D0\uC758 \uC794 \xB7 \uC77C\uC0C1"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC, \uC8FC\uC2A4\uC778 \uC904 \uC54C\uC558\uB294\uB370"
    summary: "\uB2EC\uCF64\uD55C \uB9DB\uC744 \uC608\uC0C1\uD588\uB2E4\uAC00 \uB180\uB780
      \uCCAB \uC8FC\uBB38 \uD6C4\uAE30."
    article: "\uC791\uC131\uC790 : \uB2A6\uC740\uC810\uC2EC\n\n\uBA54\uB274 \uC0AC\uC9C4\uC774
      \uC608\uBED0\uC11C \uBE14\uB7EC\uB514 \uBA54\uB9AC\uB97C \uC8FC\uBB38\uD588\uB2E4.
      \uBE68\uAC1B\uACE0 \uB808\uBAAC\uB3C4 \uAF42\uD600 \uC788\uAE38\uB798 \uC0C8\uCF64\uB2EC\uCF64\uD560
      \uC904 \uC54C\uC558\uB294\uB370 \uCCAB \uBAA8\uAE08\uBD80\uD130 \uD6C4\uCD94
      \uD5A5\uC774 \uB0AC\uB2E4.\n\n\uCE5C\uAD6C\uB294 \uCC28\uAC00\uC6B4 \uC218\uD504
      \uAC19\uB2E4\uACE0 \uD588\uACE0, \uB098\uB294 \uAC04\uC774 \uB41C \uD1A0\uB9C8\uD1A0
      \uC8FC\uC2A4 \uAC19\uC558\uB2E4. \uC774\uC0C1\uD558\uB2E4\uB294 \uB73B\uC740
      \uC544\uB2CC\uB370 \uB514\uC800\uD2B8 \uB300\uC2E0 \uACE0\uB978 \uAC74 \uC798\uBABB\uB41C
      \uC120\uD0DD\uC774\uC5C8\uB2E4. \uB2E4\uC74C\uC5D0\uB294 \uC74C\uC2DD\uC774\uB791
      \uAC19\uC774 \uC8FC\uBB38\uD574\uC57C\uACA0\uB2E4.\n\n\uB313\uAE00\n\uB2E8\uB9DB\uD30C
      : \uC0AC\uC9C4\uB9CC \uBD24\uC73C\uBA74 \uC800\uB3C4 \uAC19\uC740 \uC0DD\uAC01
      \uD588\uC744 \uB4EF.\n\uC811\uC2DC\uC218\uC9D1 : \uC74C\uB8CC\uB3C4 \uBA54\uB274
      \uC124\uBA85\uC744 \uC77D\uC5B4\uC57C \uD558\uB294 \uC774\uC720\u314B\u314B"
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC"
    openDialogueSceneId: 
    button: {fileID: 478300121}
  - category: "\uD648\uBC14 \uB178\uD2B8 \xB7 \uCDE8\uD5A5"
    title: "\uB0B4 \uBE14\uB7EC\uB514 \uBA54\uB9AC\uAC00 \uB108\uBB34 \uB9E4\uC6E0\uB358
      \uC774\uC720"
    summary: "\uB9E4\uC6B4 \uC18C\uC2A4\uB97C \uD55C\uAEBC\uBC88\uC5D0 \uB123\uC5B4
      \uBC84\uB9B0 \uD648\uBC14 \uC2E4\uD328\uB2F4."
    article: "\uC791\uC131\uC790 : \uACC4\uB7C9\uC740\uB0B4\uC77C\uBD80\uD130\n\n\uBE14\uB7EC\uB514
      \uBA54\uB9AC\uB97C \uB9CC\uB4E4\uBA74\uC11C \uB9E4\uC6B4 \uC18C\uC2A4\uB97C
      \uB208\uB300\uC911\uC73C\uB85C \uB123\uC5C8\uB2E4. \uD1A0\uB9C8\uD1A0 \uC8FC\uC2A4\uAC00
      \uB9CE\uC73C\uB2C8\uAE4C \uAD1C\uCC2E\uC744 \uC904 \uC54C\uC558\uB294\uB370
      \uC544\uB2C8\uC5C8\uB2E4. \uD5A5\uC744 \uB354\uD558\uB824\uB358 \uD6C4\uCD94\uAE4C\uC9C0
      \uD569\uCCD0\uC9C0\uB2C8 \uB2E4\uB978 \uB9DB\uC774 \uBB3B\uD614\uB2E4.\n\n\uACB0\uAD6D
      \uB450 \uC794\uC73C\uB85C \uB098\uB220\uC11C \uD1A0\uB9C8\uD1A0 \uC8FC\uC2A4\uB97C
      \uB354 \uB123\uC5C8\uB2E4. \uCDE8\uD5A5\uAECF \uB123\uC73C\uB77C\uB294 \uB9D0\uC740
      \uC544\uBB34\uB807\uAC8C\uB098 \uBD80\uC73C\uB77C\uB294 \uB9D0\uC774 \uC544\uB2C8\uC5C8\uB2E4.
      \uB2E4\uC74C\uC5D0\uB294 \uC870\uAE08 \uB123\uACE0 \uB9DB\uBD80\uD130 \uBCFC
      \uC0DD\uAC01\uC774\uB2E4.\n\n\uB313\uAE00\n\uC815\uB7C9\uC8FC\uC758 : \uB2C9\uB124\uC784\uC774
      \uBAA8\uB4E0 \uAC78 \uC124\uBA85\uD558\uB124\uC694.\n\uC791\uC740\uC794 : \uBCD1
      \uC785\uAD6C\uAC00 \uC0DD\uAC01\uBCF4\uB2E4 \uB113\uB354\uB77C\uAD6C\uC694\u314B\u314B"
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC"
    openDialogueSceneId: 
    button: {fileID: 627332760}
  - category: "\uC2DD\uD0C1 \uAC8C\uC2DC\uD310 \xB7 \uC7A1\uB2F4"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uC7A5\uC2DD, \uBA39\uB294 \uAC74\uAC00\uC694?"
    summary: "\uC794\uC5D0 \uACC1\uB4E4\uC778 \uC140\uB7EC\uB9AC\uB97C \uB450\uACE0
      \uBC8C\uC5B4\uC9C4 \uC791\uC740 \uB17C\uC7C1."
    article: "\uC791\uC131\uC790 : \uD3EC\uD06C\uD558\uB098\n\n\uBE14\uB7EC\uB514
      \uBA54\uB9AC\uC5D0 \uAF42\uD600 \uB098\uC628 \uC140\uB7EC\uB9AC\uB97C \uBA39\uC5C8\uB354\uB2C8
      \uCE5C\uAD6C\uAC00 \uADF8\uAC70 \uC7A5\uC2DD \uC544\uB2C8\uB0D0\uACE0 \uD588\uB2E4.
      \uBA40\uCA61\uD55C \uCC44\uC18C\uC778\uB370 \uC65C \uC548 \uBA39\uB0D0\uACE0
      \uD588\uB354\uB2C8 \uAF43\uB3C4 \uC7A5\uC2DD\uC73C\uB85C \uC62C\uB9B0\uB2E4\uACE0
      \uD55C\uB2E4.\n\n\uC11C\uB85C \uC544\uB294 \uCC99\uD558\uB2E4\uAC00 \uADF8\uB0E5
      \uC9C1\uC6D0\uC5D0\uAC8C \uBB3C\uC5B4\uBD24\uB2E4. \uC774 \uC794\uC758 \uC140\uB7EC\uB9AC\uB294
      \uBA39\uC5B4\uB3C4 \uB41C\uB2E4\uACE0 \uD588\uB2E4. \uC74C\uB8CC \uD55C \uC794
      \uC55E\uC5D0 \uB450\uACE0 \uC774\uB807\uAC8C \uC624\uB798 \uD1A0\uB860\uD560
      \uC77C\uC778\uAC00 \uC2F6\uC5C8\uB2E4.\n\n\uB313\uAE00\n\uC78E\uC0AC\uADC0
      : \uCE5C\uAD6C\uBD84\uC740 \uB808\uBAAC \uC870\uAC01\uB3C4 \uAD6C\uACBD\uB9CC
      \uD558\uC2DC\uB098\uC694.\n\uD3EC\uD06C\uD558\uB098 : \uB808\uBAAC\uC740 \uB610
      \uC9DC \uB123\uB354\uB77C\uAD6C\uC694."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC"
    openDialogueSceneId: 
    button: {fileID: 193249308}
  - category: "\uC791\uC740 \uC5ED\uC0AC\uC0AC\uC804 \xB7 \uC778\uBB3C"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC\uB85C \uBD88\uB9B0 \uBA54\uB9AC 1\uC138"
    summary: "1553\uB144\uBD80\uD130 1558\uB144\uAE4C\uC9C0 \uC7AC\uC704\uD55C \uC789\uAE00\uB79C\uB4DC
      \uC5EC\uC655."
    article: "\uC791\uC131\uC790 : \uC5F0\uD45C\uC815\uB9AC\uBC18\n\n\uBA54\uB9AC
      1\uC138\uB294 1553\uB144\uBD80\uD130 1558\uB144\uAE4C\uC9C0 \uC789\uAE00\uB79C\uB4DC\uB97C
      \uD1B5\uCE58\uD588\uB2E4. \uD5E8\uB9AC 8\uC138\uC640 \uC544\uB77C\uACE4\uC758
      \uCE90\uC11C\uB9B0 \uC0AC\uC774\uC5D0\uC11C \uD0DC\uC5B4\uB0AC\uC73C\uBA70
      \uD29C\uB354 \uC655\uC870\uC758 \uAD70\uC8FC\uB2E4.\n\n\uADF8\uB140\uC758 \uD1B5\uCE58
      \uC2DC\uAE30\uC5D0\uB294 \uAC00\uD1A8\uB9AD \uBCF5\uADC0 \uC815\uCC45\uACFC
      \uAC1C\uC2E0\uAD50\uB3C4 \uBC15\uD574\uAC00 \uC9C4\uD589\uB418\uC5C8\uB2E4.
      '\uBE14\uB7EC\uB514 \uBA54\uB9AC'\uB77C\uB294 \uBCC4\uBA85\uC740 \uC774 \uC885\uAD50\uC801
      \uBC15\uD574\uC640 \uC5F0\uACB0\uB418\uC5B4 \uC54C\uB824\uC838 \uC788\uB2E4.\n\n\uC778\uBB3C\uC744
      \uC815\uB9AC\uD560 \uB54C\uB294 \uBCC4\uBA85\uB9CC \uC678\uC6B0\uAE30\uBCF4\uB2E4
      \uC7AC\uC704 \uC2DC\uAE30\uC640 \uB2F9\uC2DC\uC758 \uC885\uAD50 \uAC08\uB4F1\uC744
      \uD568\uAED8 \uC0B4\uD3B4\uBCF4\uB294 \uD3B8\uC774 \uC774\uD574\uD558\uAE30
      \uC27D\uB2E4."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC"
    openDialogueSceneId: 
    button: {fileID: 600308813}
  - category: "\uC5F0\uD45C \uCC45\uAC08\uD53C \xB7 \uC5ED\uC0AC"
    title: "\uBA54\uB9AC 1\uC138\uC758 \uC7AC\uC704 \uAE30\uAC04 \uC815\uB9AC"
    summary: "\uC5D0\uB4DC\uC6CC\uB4DC 6\uC138\uC640 \uC5D8\uB9AC\uC790\uBCA0\uC2A4
      1\uC138 \uC0AC\uC774\uC758 \uC2DC\uAE30."
    article: "\uC791\uC131\uC790 : \uCC45\uAC08\uD53C\uC138\uC7A5\n\n\uD29C\uB354
      \uC655\uC870 \uC5F0\uD45C\uB97C \uC77D\uB2E4\uAC00 '\uBE14\uB7EC\uB514 \uBA54\uB9AC'\uB77C\uB294
      \uC774\uB984\uC5D0\uC11C \uBA48\uCDC4\uB2E4. \uBCC4\uBA85\uC73C\uB85C\uB9CC
      \uAE30\uC5B5\uD588\uB358 \uBA54\uB9AC 1\uC138\uC758 \uC7AC\uC704 \uAE30\uAC04\uC740
      1553~1558\uB144\uC774\uB2E4.\n\n\uC5D0\uB4DC\uC6CC\uB4DC 6\uC138 \uC774\uD6C4
      \uC655\uC704 \uACC4\uC2B9\uC744 \uB458\uB7EC\uC2FC \uAC08\uB4F1 \uC18D\uC5D0\uC11C
      \uC989\uC704\uD588\uACE0, \uBA54\uB9AC 1\uC138 \uC0AC\uD6C4\uC5D0\uB294 \uC5D8\uB9AC\uC790\uBCA0\uC2A4
      1\uC138\uAC00 \uC655\uC704\uB97C \uC774\uC5C8\uB2E4. \uC774\uB984\uB9CC \uB530\uB85C
      \uC678\uC6E0\uC744 \uB54C\uBCF4\uB2E4 \uC55E\uB4A4 \uAD70\uC8FC\uB97C \uC5F0\uACB0\uD558\uB2C8
      \uC2DC\uB300 \uAD6C\uBD84\uC774 \uC26C\uC6CC\uC84C\uB2E4.\n\n\uB313\uAE00\n\uBC11\uC904\uAE0B\uAE30
      : \uC800\uB3C4 \uC0AC\uB78C \uC774\uB984\uBCF4\uB2E4 \uC21C\uC11C\uAC00 \uD5F7\uAC08\uB838\uC5B4\uC694."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC"
    openDialogueSceneId: 
    button: {fileID: 1193626886}
  - category: "\uC5ED\uC0AC \uC9C8\uBB38\uBC29 \xB7 \uC9C8\uC758\uC751\uB2F5"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC\uB294 \uC2A4\uCF54\uD2C0\uB79C\uB4DC
      \uC5EC\uC655\uC778\uAC00\uC694?"
    summary: "\uC774\uB984\uC774 \uAC19\uC740 \uB450 \uBA54\uB9AC\uB97C \uAD6C\uBD84\uD558\uB294
      \uC9E7\uC740 \uB2F5\uBCC0."
    article: "\uC791\uC131\uC790 : \uC774\uB984\uC774\uB108\uBB34\uB9CE\uC544\n\n\uCC45\uB9C8\uB2E4
      \uBA54\uB9AC\uAC00 \uB098\uC640\uC11C \uD5F7\uAC08\uB9BD\uB2C8\uB2E4. \uBE14\uB7EC\uB514
      \uBA54\uB9AC\uB791 \uC2A4\uCF54\uD2C0\uB79C\uB4DC\uC758 \uBA54\uB9AC \uC5EC\uC655\uC774
      \uAC19\uC740 \uC0AC\uB78C\uC778\uAC00\uC694?\n\n\uB2F5\uBCC0 \xB7 \uC624\uB798\uB41C\uC9C0\uB3C4\n\uB2E4\uB978
      \uC778\uBB3C\uC785\uB2C8\uB2E4. \uBE14\uB7EC\uB514 \uBA54\uB9AC\uB85C \uC54C\uB824\uC9C4
      \uC778\uBB3C\uC740 \uC789\uAE00\uB79C\uB4DC\uC758 \uBA54\uB9AC 1\uC138, \uC989
      \uBA54\uB9AC \uD29C\uB354\uC785\uB2C8\uB2E4. \uC2A4\uCF54\uD2C0\uB79C\uB4DC\uC758
      \uBA54\uB9AC \uC5EC\uC655\uC740 \uBA54\uB9AC \uC2A4\uD29C\uC5B4\uD2B8\uC785\uB2C8\uB2E4.
      \uC774\uB984 \uC606\uC5D0 \uC655\uAD6D\uC774\uB098 \uAC00\uBB38\uC744 \uC801\uC5B4
      \uB450\uBA74 \uAD6C\uBD84\uD558\uAE30 \uD3B8\uD569\uB2C8\uB2E4.\n\n\uB313\uAE00\n\uC774\uB984\uC774\uB108\uBB34\uB9CE\uC544
      : \uAC19\uC740 \uC774\uB984\uC774\uB77C \uC0DD\uAE34 \uD63C\uB780\uC774\uC5C8\uB124\uC694.
      \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC"
    openDialogueSceneId: 
    button: {fileID: 386756292}
  - category: "\uBC15\uBB3C\uAD00 \uC0B0\uCC45 \xB7 \uAC10\uC0C1"
    title: "\uBCC4\uBA85\uBCF4\uB2E4 \uBA3C\uC800 \uBCF8 \uBA54\uB9AC 1\uC138\uC758
      \uCD08\uC0C1"
    summary: "\uCD08\uC0C1\uD654 \uC124\uBA85\uC744 \uC77D\uC73C\uBA70 \uC815\uB9AC\uD55C
      \uC778\uBB3C \uAC10\uC0C1."
    article: "\uC791\uC131\uC790 : \uB290\uB9B0\uAD00\uB78C\n\n\uBA54\uB9AC 1\uC138\uC758
      \uCD08\uC0C1\uD654\uB97C \uBCF4\uACE0 \uB098\uC11C \uC124\uBA85\uC5D0 \uC801\uD78C
      '\uBE14\uB7EC\uB514 \uBA54\uB9AC'\uB97C \uC77D\uC5C8\uB2E4. \uBCC4\uBA85\uC73C\uB85C
      \uBA3C\uC800 \uC811\uD588\uC744 \uB54C \uC0C1\uC0C1\uD588\uB358 \uC778\uC0C1\uACFC\uB294
      \uB2EC\uB77C\uC11C \uD55C\uB3D9\uC548 \uADF8\uB9BC \uC55E\uC5D0 \uC11C \uC788\uC5C8\uB2E4.\n\n\uC637\uC774\uB098
      \uC790\uC138\uB97C \uAD6C\uACBD\uD558\uB2E4\uAC00 \uB2E4\uC2DC \uC124\uBA85\uBB38\uC73C\uB85C
      \uB3CC\uC544\uC654\uB2E4. \uD55C \uC0AC\uB78C\uC758 \uC774\uBBF8\uC9C0\uB97C
      \uBCC4\uBA85 \uD558\uB098\uB85C\uB9CC \uAE30\uC5B5\uD558\uACE0 \uC788\uC5C8\uB2E4\uB294
      \uAC8C \uC0C8\uC0BC \uB290\uAEF4\uC84C\uB2E4. \uB2E4\uC74C\uC5D0\uB294 \uD29C\uB354
      \uC655\uC870\uC758 \uB2E4\uB978 \uCD08\uC0C1\uD654\uB3C4 \uC774\uC5B4\uC11C
      \uBCF4\uACE0 \uC2F6\uB2E4.\n\n\uB313\uAE00\n\uC804\uC2DC\uC88B\uC544 : \uC124\uBA85
      \uC77D\uAE30 \uC804\uD6C4\uB85C \uADF8\uB9BC\uC774 \uB2E4\uB974\uAC8C \uBCF4\uC77C
      \uB54C\uAC00 \uC788\uC8E0."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC"
    openDialogueSceneId: 
    button: {fileID: 1449747537}
  - category: "\uC2EC\uC57C \uAC8C\uC2DC\uD310 \xB7 \uD6C4\uAE30"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220 \uD574 \uBCF8 \uD6C4\uAE30"
    summary: "\uAC70\uC6B8 \uC18D \uBB34\uC5B8\uAC00\uB97C \uBD24\uB2E4\uB294 \uAE00\uACFC
      \uBBFF\uC9C0 \uC54A\uB294 \uB313\uAE00\uB4E4."
    article: "\uC791\uC131\uC790 : \uC0C8\uBCBD\uC591\uB9D0\n\n\uCE5C\uAD6C\uB791
      \uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220 \uD574 \uBD24\uB294\uB370
      \uAC70\uC6B8 \uAD6C\uC11D\uC5D0\uC11C \uBB54\uAC00 \uC6C0\uC9C1\uC778 \uAC83
      \uAC19\uC558\uC74C. \uB098\uB294 \uBD24\uB2E4\uACE0 \uD588\uACE0 \uCE5C\uAD6C\uB294
      \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uB2E4\uACE0 \uD568. \uB05D\uB098\uACE0
      \uBD88 \uCF1C\uB2C8\uAE4C \uADF8\uB0E5 \uD3C9\uC18C \uC695\uC2E4\uC774\uC5C8\uB2E4.\n\n\uC601\uC0C1
      \uCC0D\uC73C\uB824\uACE0 \uD588\uB294\uB370 \uB108\uBB34 \uC5B4\uB450\uC6CC\uC11C
      \uC544\uBB34\uAC83\uB3C4 \uC548 \uB098\uC654\uB2E4. \uC774\uB7F4 \uC904 \uC54C\uC558\uC73C\uBA74
      \uC870\uBA85\uC744 \uC870\uAE08 \uCF1C \uB458\uAC78. \uC544\uC9C1\uB3C4 \uBB50\uC600\uB294\uC9C0
      \uBAA8\uB974\uACA0\uC74C.\n\n\uB313\uAE00\n\uD569\uB9AC\uC801\uC778\uAC10\uC790
      : \uADF8\uAC70 \uB108 \uC6C0\uC9C1\uC778 \uAC70 \uC544\uB2D8?\n\uD53D\uC140\uC81C\uB85C
      : \uC99D\uAC70\uB294 \uD56D\uC0C1 \uC5B4\uB450\uC6CC\uC11C \uC548 \uCC0D\uD788\uB354\uB77C.\n\uD68C\uC804\uBB38
      : \uB2E4\uC74C \uD3B8\uC740 \uAC70\uC6B8 \uB4A4\uC5D0 \uC218\uAC74 \uC788\uC5C8\uB2E4\uB294
      \uACB0\uB9D0 \uC608\uC0C1."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220"
    openDialogueSceneId: 
    button: {fileID: 402992284}
  - category: "\uC624\uCEEC\uD2B8 \uC9C8\uBB38\uBC29 \xB7 \uC9C8\uBB38"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220 \uC5B4\uB514\uC11C
      \uBC30\uC6B0\uB098\uC694?"
    summary: "\uC11C\uB85C \uB2E4\uB978 \uC124\uBA85 \uB54C\uBB38\uC5D0 \uC6D0\uBB38\uC744
      \uCC3E\uB294 \uC9C8\uBB38 \uAE00."
    article: "\uC791\uC131\uC790 : \uAC80\uC0C9\uC5F4\uB450\uBC88\n\n\uBE14\uB7EC\uB514
      \uBA54\uB9AC \uAC15\uB839\uC220 \uAC80\uC0C9\uD558\uBA74 \uAE00\uB9C8\uB2E4
      \uC124\uBA85\uC774 \uB2EC\uB77C\uC694. \uAC70\uC6B8\uB85C \uD55C\uB2E4\uB294
      \uAE00\uB3C4 \uC788\uACE0 \uCEF4\uD4E8\uD130\uB85C \uD55C\uB2E4\uB294 \uAE00\uB3C4
      \uC788\uB294\uB370 \uBB58 \uBCF4\uACE0 \uB530\uB77C \uD558\uB294 \uAC74\uAC00\uC694?
      \uC6D0\uBB38 \uAC19\uC740 \uAC8C \uC788\uC73C\uBA74 \uC77D\uC5B4 \uBCF4\uACE0
      \uC2F6\uC5B4\uC694.\n\n\uB313\uAE00\n\uD0ED\uC218\uC9D1\uAC00 : \uCEF4\uD4E8\uD130\uB85C
      \uD558\uB294 \uCABD\uC740 Bloody.org\uB77C\uB294 \uC0AC\uC774\uD2B8\uC5D0\uC11C
      \uBD24\uC5B4\uC694. \uAE00 \uC62E\uACA8 \uB193\uC740 \uB370 \uB9D0\uACE0 \uADF8\uCABD
      \uC124\uBA85 \uC77D\uC5B4 \uBCF4\uC138\uC694.\n\uCC2C\uBB3C\uD55C\uC794 : \uC6D0\uBB38
      \uC788\uB2E4\uACE0 \uC9C4\uC9DC \uB418\uB294 \uAC74 \uC544\uB2D0 \uD150\uB370.\n\uAC80\uC0C9\uC5F4\uB450\uBC88
      : \uC77C\uB2E8 \uC124\uBA85\uC774 \uC5B4\uB5BB\uAC8C \uB2E4\uB978\uC9C0 \uBCF4\uB824\uB294
      \uAC70\uC608\uC694."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220"
    openDialogueSceneId: 
    button: {fileID: 2021080107}
  - category: "\uBC24\uC0D8 \uB77C\uC6B4\uC9C0 \xB7 \uD6C4\uAE30"
    title: "\uCEF4\uD4E8\uD130\uB85C \uBE14\uB7EC\uB514 \uBA54\uB9AC \uD574 \uBD24\uC74C"
    summary: "\uD654\uBA74\uC774 \uC774\uC0C1\uD588\uB2E4\uB294 \uC8FC\uC7A5\uC5D0
      \uC99D\uAC70\uB97C \uC694\uAD6C\uD558\uB294 \uBC18\uC751."
    article: "\uC791\uC131\uC790 : \uBAA8\uB2C8\uD130\uBA3C\uC9C0\n\nBloody.org\uC5D0
      \uC801\uD78C \uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220 \uBCF4\uACE0
      \uD574 \uBD24\uB294\uB370 \uD654\uBA74\uC774 \uC7A0\uAE50 \uC774\uC0C1\uD574\uC9C4
      \uAC83 \uAC19\uC558\uB2E4. \uB208\uC744 \uAE5C\uBE61\uC774\uB2C8\uAE4C \uC6D0\uB798\uB300\uB85C
      \uB3CC\uC544\uC640\uC11C \uC815\uD655\uD788 \uBB58 \uBD24\uB2E4\uACE0 \uC124\uBA85\uD558\uAE30\uAC00
      \uC560\uB9E4\uD568.\n\n\uCE5C\uAD6C\uD55C\uD14C \uB9D0\uD588\uB354\uB2C8 \uBAA8\uB2C8\uD130
      \uCF00\uC774\uBE14\uBD80\uD130 \uD655\uC778\uD558\uB798\uC11C \uAD1C\uD788
      \uB9D0\uD588\uB098 \uC2F6\uB2E4. \uC0AC\uC9C4\uC740 \uC5C6\uB2E4. \uB2E4\uC2DC
      \uD558\uBA74\uC11C \uCC0D\uC73C\uB77C\uACE0 \uD558\uC9C0 \uB9C8\uC148. \uADF8\uB0E5
      \uD6C4\uAE30 \uB0A8\uAE30\uB294 \uAC70\uC784.\n\n\uB313\uAE00\n\uCF00\uC774\uBE14\uC815\uB9AC
      : \uCE5C\uAD6C \uB9D0\uC774 \uC81C\uC77C \uBBFF\uC74C\uC9C1\uD558\uB124.\n\uD504\uB808\uC784\uB4DC\uB78D
      : \uD654\uBA74 \uC774\uC0C1\uD558\uBA74 \uADC0\uC2E0\uBCF4\uB2E4 \uADF8\uB798\uD53D
      \uC124\uC815\uBD80\uD130 \uBD10\uC57C\uC9C0.\n\uC7A0\uC880\uC790 : \uC624\uB798
      \uBCF4\uACE0 \uC788\uC73C\uBA74 \uB208\uB3C4 \uD53C\uACE4\uD568."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220"
    openDialogueSceneId: 
    button: {fileID: 1547300326}
  - category: "\uC18C\uBB38 \uC218\uCCA9 \xB7 \uBC29\uBC95 \uC815\uB9AC"
    title: "\uAC70\uC6B8\uB85C \uD558\uB294 \uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220?"
    summary: "\uC778\uD130\uB137\uC5D0 \uB5A0\uB3C4\uB294 \uAC70\uC6B8 \uB180\uC774
      \uC124\uBA85\uC744 \uBE44\uAD50\uD55C \uAE00."
    article: "\uC791\uC131\uC790 : \uC885\uC774\uB2EC\n\n\uBE14\uB7EC\uB514 \uBA54\uB9AC
      \uAC15\uB839\uC220\uC744 \uAC70\uC6B8 \uC55E\uC5D0\uC11C \uD558\uB294 \uB180\uC774\uB85C
      \uC18C\uAC1C\uD558\uB294 \uAE00\uB4E4\uC744 \uBAA8\uC544 \uBD24\uB2E4. \uB300\uCCB4\uB85C
      \uC5B4\uB450\uC6B4 \uACF3\uC5D0\uC11C \uAC70\uC6B8\uC744 \uBC14\uB77C\uBCF4\uACE0
      \uC774\uB984\uC744 \uBD80\uB974\uB294 \uC2DD\uC778\uB370, \uC138\uBD80 \uC124\uBA85\uC740
      \uAE00\uB9C8\uB2E4 \uB2E4\uB974\uB2E4.\n\n\uCD1B\uBD88\uC744 \uCF1C\uB77C\uB294
      \uAE00\uACFC \uBD88\uC744 \uC804\uBD80 \uB044\uB77C\uB294 \uAE00\uC774 \uD568\uAED8
      \uB3CC\uC544\uB2E4\uB2C8\uACE0 \uC788\uC5C8\uB2E4. \uC5B4\uB290 \uC124\uBA85\uC774
      \uBA3C\uC800\uC600\uB294\uC9C0\uB3C4 \uCC3E\uC9C0 \uBABB\uD588\uB2E4. \uC544\uB798
      \uB313\uAE00\uC5D0\uC11C\uB3C4 \uC11C\uB85C \uB2E4\uB978 \uBC84\uC804\uC744
      \uC54C\uACE0 \uC788\uC5B4\uC11C \uD558\uB098\uC758 \uC815\uB2F5\uCC98\uB7FC
      \uC815\uB9AC\uD558\uAE30\uB294 \uC5B4\uB824\uC6E0\uB2E4.\n\n\uB313\uAE00\n\uBCF5\uBD99\uAC10\uBCC4\uC0AC
      : \uB2E4\uB4E4 \uC5B4\uB514\uC11C \uBCF8 \uAC78 \uB2E4\uC2DC \uC4F0\uB294 \uAC70
      \uC544\uB2CC\uAC00\uC694.\n\uB9D1\uC740\uC720\uB9AC : \uBC29\uBC95\uC774 \uACC4\uC18D
      \uBC14\uB00C\uB294 \uAC8C \uC218\uC0C1\uD568\u314B\u314B"
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220"
    openDialogueSceneId: 
    button: {fileID: 143441931}
  - category: "\uAD34\uB2F4 \uD734\uAC8C\uC2E4 \xB7 \uD6C4\uAE30"
    title: "\uAC15\uB839\uC220 \uD558\uB2E4\uAC00 \uBE44\uBA85 \uC9C0\uB978 \uC774\uC720"
    summary: "\uBB34\uC11C\uC6B4 \uBD84\uC704\uAE30\uB97C \uB9CC\uB4E4\uC5C8\uB2E4\uAC00
      \uC2A4\uC2A4\uB85C \uB180\uB780 \uACBD\uD5D8\uB2F4."
    article: "\uC791\uC131\uC790 : \uC774\uBD88\uBC16\uC740\uCD94\uC6CC\n\n\uBE14\uB7EC\uB514
      \uBA54\uB9AC \uAC15\uB839\uC220 \uD574 \uBCF4\uACA0\uB2E4\uACE0 \uBC29 \uC815\uB9AC\uD558\uACE0
      \uC549\uC558\uB294\uB370 \uB4A4\uCABD\uC5D0\uC11C \uAC80\uC740 \uAC8C \uD22D
      \uB5A8\uC5B4\uC84C\uB2E4. \uC9C4\uC9DC \uC18C\uB9AC \uC9C0\uB974\uACE0 \uC758\uC790\uAE4C\uC9C0
      \uBC00\uC5C8\uC74C. \uCE5C\uAD6C\uB3C4 \uAC19\uC774 \uB180\uB77C\uC11C \uB458
      \uB2E4 \uBB38\uC73C\uB85C \uB2EC\uB824\uAC14\uB2E4.\n\n\uBD88 \uCF1C\uACE0
      \uBCF4\uB2C8 \uC758\uC790\uC5D0 \uAC78\uCCD0 \uB454 \uC810\uD37C\uC600\uC74C.
      \uC637\uAC78\uC774\uC5D0 \uAC78\uACE0 \uC2DC\uC791\uD588\uC73C\uBA74 \uC774\uB7F0
      \uC77C\uC740 \uC5C6\uC5C8\uC744 \uD150\uB370. \uC544\uBB34\uD2BC \uC2EC\uC7A5\uC740
      \uD655\uC2E4\uD788 \uBE68\uB9AC \uB6F0\uC5C8\uB2E4.\n\n\uB313\uAE00\n\uC815\uB9AC\uC815\uB3C8
      : \uD1F4\uB9C8\uBCF4\uB2E4 \uCCAD\uC18C\uAC00 \uBA3C\uC800\uC600\uB124.\n\uBC24\uC2DD\uBE75
      : \uADC0\uC2E0\uC740 \uCD9C\uADFC\uB3C4 \uBABB \uD588\uB294\uB370 \uB05D\uB0AC\uAD70."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220"
    openDialogueSceneId: 
    button: {fileID: 3708029}
  - category: "\uCDE8\uBBF8 \uB9C1\uD06C\uC7A5 \xB7 \uC548\uB0B4"
    title: "PC \uAC15\uB839\uC220 \uC124\uBA85 \uCC3E\uB294 \uC0AC\uB78C\uB4E4 \uBCF4\uC138\uC694"
    summary: "\uAC70\uC6B8 \uBC29\uC2DD\uACFC \uCEF4\uD4E8\uD130 \uBC29\uC2DD\uC744
      \uD63C\uB3D9\uD558\uB294 \uC9C8\uBB38\uC5D0 \uB300\uD55C \uC548\uB0B4."
    article: "\uC791\uC131\uC790 : \uBD81\uB9C8\uD06C\uC0C1\uC790\n\n\uBE14\uB7EC\uB514
      \uBA54\uB9AC \uAC15\uB839\uC220 \uD558\uB294 \uBC95 \uBB3B\uB294 \uAE00\uC5D0
      \uAC70\uC6B8 \uBC84\uC804\uC774\uB791 PC \uBC84\uC804\uC774 \uACC4\uC18D \uC11E\uC5EC\uC11C
      \uB2F5\uBCC0 \uB2EC\uB9AC\uAE38\uB798 \uC801\uC2B5\uB2C8\uB2E4. \uCEF4\uD4E8\uD130\uB85C
      \uD558\uB294 \uC124\uBA85\uC744 \uCC3E\uB294\uB2E4\uBA74 Bloody.org \uCABD\uC744
      \uD655\uC778\uD574 \uBCF4\uC138\uC694.\n\n\uC5EC\uAE30\uC5D0 \uC21C\uC11C\uB97C
      \uB2E4\uC2DC \uC62E\uAE30\uBA74 \uB610 \uBB38\uC7A5 \uBE60\uC84C\uB2E4\uACE0
      \uC2F8\uC6B8 \uAC83 \uAC19\uC544\uC11C \uC0AC\uC774\uD2B8 \uC774\uB984\uB9CC
      \uB0A8\uAE41\uB2C8\uB2E4. \uC800\uB294 \uC77D\uAE30\uB9CC \uD588\uACE0 \uC9C1\uC811
      \uD574 \uBCF4\uC9C0\uB294 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uC131\uACF5 \uC5EC\uBD80
      \uBB3C\uC5B4\uBCF4\uC154\uB3C4 \uBAA8\uB985\uB2C8\uB2E4.\n\n\uB313\uAE00\n\uC548\uBBFF\uB294\uC0AC\uB78C
      : \uC0AC\uC774\uD2B8\uAE4C\uC9C0 \uB9CC\uB4E4\uC5C8\uB124. \uC815\uC131\uC774\uB2E4.\n\uD31D\uCF58\uADF8\uB987
      : \uC8FC\uC18C \uC788\uB294 \uAD34\uB2F4\uC774\uB77C\uACE0 \uB354 \uBBFF\uAE30\uC9C4
      \uC54A\uC74C."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220"
    openDialogueSceneId: 
    button: {fileID: 983636220}
  - category: "\uC790\uC815 \uC9C8\uBB38\uBC29 \xB7 \uC9C8\uBB38"
    title: "\uAC15\uB839\uC220 \uC900\uBE44\uBB3C, \uAE00\uB9C8\uB2E4 \uC65C \uB2EC\uB77C\uC694?"
    summary: "\uC900\uBE44\uBB3C \uBAA9\uB85D\uC774 \uC81C\uAC01\uAC01\uC774\uB77C\uB294
      \uC9C8\uBB38\uACFC \uD68C\uC758\uC801\uC778 \uB2F5\uBCC0."
    article: "\uC791\uC131\uC790 : \uC900\uBE44\uB9CC\uC0BC\uC77C\n\n\uBE14\uB7EC\uB514
      \uBA54\uB9AC \uAC15\uB839\uC220 \uC900\uBE44\uBB3C \uCC3E\uC544\uBCF4\uB294\uB370
      \uC5B4\uB5A4 \uAE00\uC740 \uD070 \uAC70\uC6B8\uC774 \uD544\uC694\uD558\uB2E4
      \uD558\uACE0 \uC5B4\uB5A4 \uAE00\uC740 \uC791\uC740 \uAC70\uC6B8\uB3C4 \uB41C\uB300\uC694.
      \uBC29 \uD06C\uAE30\uB3C4 \uC0C1\uAD00\uC788\uB098\uC694? \uC77D\uC73C\uBA74
      \uC77D\uC744\uC218\uB85D \uC900\uBE44\uBB3C\uB9CC \uB298\uC5B4\uB0A8.\n\n\uB313\uAE00\n\uD604\uC2E4\uC801\uC778\uCF69
      : \uADF8\uB0E5 \uAE00\uC4F4 \uC0AC\uB78C \uC9D1\uC5D0 \uC788\uB294 \uBB3C\uAC74
      \uC801\uC740 \uAC70 \uAC19\uC740\uB370.\n\uBE48\uC7A5\uBC14\uAD6C\uB2C8 : \uC900\uBE44\uB9CC
      \uD558\uB2E4\uAC00 \uD765\uBBF8 \uC2DD\uC744 \uB4EF.\n\uC900\uBE44\uB9CC\uC0BC\uC77C
      : \uC774\uBBF8 \uC880 \uC2DD\uC5C8\uC5B4\uC694."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220"
    openDialogueSceneId: 
    button: {fileID: 1861771134}
  - category: "\uC775\uBA85 \uAD34\uB2F4\uBC29 \xB7 \uD6C4\uAE30"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uBD24\uB2E4\uB294 \uCE5C\uAD6C \uC774\uC57C\uAE30"
    summary: "\uCE5C\uAD6C\uC758 \uC131\uACF5\uB2F4\uC744 \uC804\uD588\uC9C0\uB9CC
      \uC544\uBB34\uB3C4 \uBBFF\uC5B4 \uC8FC\uC9C0 \uC54A\uB294\uB2E4."
    article: "\uC791\uC131\uC790 : \uD55C\uBA85\uAC74\uB108\uB4E4\uC74C\n\n\uCE5C\uAD6C\uAC00
      \uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220 \uC131\uACF5\uD588\uB2E4\uB294\uB370
      \uC790\uC138\uD788 \uBB3C\uC5B4\uBCF4\uBA74 \uC790\uAFB8 \uB9D0\uC744 \uBC14\uAFC8.
      \uCC98\uC74C\uC5D4 \uBD84\uBA85 \uC5BC\uAD74\uC744 \uBD24\uB2E4\uB354\uB2C8
      \uB098\uC911\uC5D4 \uC0AC\uB78C \uAC19\uC740 \uADF8\uB9BC\uC790\uC600\uB300.
      \uADF8\uB798\uB3C4 \uD3C9\uC18C\uC5D0 \uC774\uB7F0 \uC598\uAE30 \uC548 \uD558\uB294
      \uC560\uB77C \uC2E0\uACBD \uC4F0\uC784.\n\n\uAC19\uC774 \uC788\uB358 \uC0AC\uB78C\uC740
      \uC5C6\uACE0 \uB0A8\uAE34 \uC0AC\uC9C4\uB3C4 \uC5C6\uB2E4\uACE0 \uD568. \uC5EC\uAE30
      \uD574 \uBCF8 \uC0AC\uB78C \uC788\uC73C\uBA74 \uBE44\uC2B7\uD588\uB294\uC9C0
      \uC54C\uB824 \uC8FC\uC138\uC694.\n\n\uB313\uAE00\n\uCD9C\uCC98\uC5B4\uB528\uC74C
      : \uCE5C\uAD6C\uC758 \uCE5C\uAD6C\uAE4C\uC9C0 \uAC00\uBA74 \uB354 \uC790\uC138\uD574\uC9C8
      \uB4EF.\n\uD750\uB9B0\uB208 : \uBCF8\uC778\uB3C4 \uBB58 \uBD24\uB294\uC9C0
      \uBAA8\uB974\uB294 \uAC70 \uAC19\uC740\uB370.\n\uB9C8\uAC10\uC9C1\uC804 : \uC624\uB298\uB3C4
      \uC0AC\uC9C4 \uC5C6\uB294 \uBAA9\uACA9\uB2F4 \uD55C \uD3B8 \uCD94\uAC00."
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220"
    openDialogueSceneId: 
    button: {fileID: 522787188}
  - category: "Bloody.org \xB7 \uC758\uC2DD \uC808\uCC28"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220 \u2014 PC \uC758\uC2DD"
    summary: "\uC758\uC2DD\uC758 \uC900\uBE44, \uC9C4\uD589 \uC808\uCC28 \uBC0F \uC900\uC218
      \uC0AC\uD56D."
    article: "Bloody.org\n\n\u25A0 \uBAA9\uC801\n<link=\"mary_spouse\">\uBA54\uB9AC\uB97C
      \uC18C\uD658\uD558\uC5EC \uBBF8\uB798\uC758 \uBC30\uC6B0\uC790\uB97C \uD655\uC778\uD558\uB294
      \uC758\uC2DD.</link>\n\n\u25A0 \uC900\uBE44\n1. \uC900\uBE44\uBB3C: \uCEA0\uC774
      \uC5F0\uACB0\uB41C \uCEF4\uD4E8\uD130, \uD654\uC0C1 \uD1B5\uD654 \uD504\uB85C\uADF8\uB7A8.\n2.
      \uC2E4\uD589 \uC2DC\uAC01: \uBC24 12\uC2DC.\n3. \uC2DC\uC791 \uC804 \uC9C4\uD589
      \uC808\uCC28\uC640 \uC720\uC758\uC0AC\uD56D\uC744 \uBAA8\uB450 \uC219\uC9C0\uD55C\uB2E4.\n\n\u25A0
      \uC9C4\uD589 \uC808\uCC28\n1. \uBC24 12\uC2DC\uC5D0 \uCEA0\uC744 \uC5F0\uACB0\uD55C
      \uB4A4 \uBE14\uB7EC\uB514 \uBA54\uB9AC \uC0AC\uC774\uD2B8\uC5D0 \uC811\uC18D\uD55C\uB2E4.\n2.
      \uD654\uBA74\uC5D0 \uC790\uC2E0\uC758 \uCEA0 \uC601\uC0C1\uC774 \uD45C\uC2DC\uB418\uB294\uC9C0
      \uD655\uC778\uD55C\uB2E4.\n3. \uD654\uBA74\uC744 \uBC14\uB77C\uBCF4\uBA70 \u2018\uBE14\uB7EC\uB514
      \uBA54\uB9AC\u2019\uB97C \uC138 \uBC88 \uC678\uCE5C\uB2E4.\n4. \uBA54\uB9AC\uAC00
      \uB098\uD0C0\uB098\uBA74 \uC190\uC5D0 \uB4E0 \uBB3C\uAC74\uBD80\uD130 \uD655\uC778\uD55C\uB2E4.\n5.
      \uC544\uB798 \uC911\uB2E8 \uC870\uAC74\uC5D0 \uD574\uB2F9\uD558\uC9C0 \uC54A\uC73C\uBA74
      \uBBF8\uB798\uC758 \uBC30\uC6B0\uC790\uB97C \uBB3B\uB294\uB2E4.\n\n\u25A0 \uC720\uC758\uC0AC\uD56D\n<link=\"mary_weapon\">1.
      \uCE7C\uC744 \uB4E0 \uBA54\uB9AC\uAC00 \uB098\uD0C0\uB098\uBA74 \uC989\uC2DC
      \uD1B5\uD654\uB97C \uC885\uB8CC\uD55C\uB2E4.</link>\n   \uCD94\uAC00 \uC9C8\uBB38
      \uC5C6\uC774 \uD1B5\uD654 \uC885\uB8CC \uBC84\uD2BC\uC744 \uB204\uB97C \uAC83.\n\n<link=\"mary_forbidden\">2.
      \u2018\uB124 \uC544\uC774\uB294 \uB0B4\uAC00 \uC8FD\uC600\uC5B4\u2019\uB77C\uB294
      \uBC1C\uC5B8\uC740 \uAE08\uC9C0\uD55C\uB2E4.</link>\n   \uD574\uB2F9 \uBC1C\uC5B8
      \uC2DC \uB098\uD0C0\uB098\uB294 \uD604\uC0C1:\n   <veil>\uBA54\uB9AC\uC758
      \uC5BC\uAD74\uC744 \uBCF4\uAC8C \uB420 \uAC83<revealed><color=#C31D1D><link=\"mary_curse\">\uBA54\uB9AC\uAC00
      \uB2F9\uC2E0\uC744 \uC6A9\uC11C\uD558\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4.</link></color></revealed></veil>\n<vision>\n\n<link=\"mary_weakness\">3.
      \uBA54\uB9AC\uB294 '\uB124 \uC544\uAE30\uB294 \uC8FD\uC9C0 \uC54A\uC558\uC5B4'
      \uB77C\uB294 \uB9D0\uC5D0 \uD76C\uB9DD\uC744 \uAC16\uB294\uB2E4</link></vision>"
    searchTerms:
    - Bloody.org
    openDialogueSceneId: 
    button: {fileID: 700885289}
  - category: "\uC624\uCEEC\uD2B8 \uC9C8\uBB38\uBC29 \xB7 \uC9C8\uBB38"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220 \uBD80\uC791\uC6A9
      \uC9C8\uBB38"
    summary: "\uAE08\uC9C0\uB41C \uB9D0\uC744 \uD588\uC744 \uB54C \uC815\uD655\uD788
      \uBB34\uC2A8 \uC77C\uC774 \uC0DD\uAE30\uB294\uC9C0 \uAD81\uAE08\uD569\uB2C8\uB2E4."
    article: "\uC791\uC131\uC790 : seoyeon041\n\n<link=\"mary_comment\">\uBE14\uB7EC\uB514
      \uBA54\uB9AC \uAC15\uB839\uC220 \uC124\uBA85\uC5D0 \u2018\uB124 \uC544\uC774\uB294
      \uB0B4\uAC00 \uC8FD\uC600\uC5B4\u2019\uB77C\uB294 \uB9D0\uC740 \uD558\uC9C0
      \uB9D0\uB77C\uACE0 \uB418\uC5B4 \uC788\uB358\uB370\uC694.\n\n\uC774\uAC70 \uB9D0\uD558\uBA74
      \uC815\uD655\uD788 \uC5B4\uB5BB\uAC8C \uB418\uB294 \uAC74\uAC00\uC694? \uADF8\uB0E5
      \uD654\uBA74\uC5D0 \uC5BC\uAD74 \uAC19\uC740 \uAC8C \uB728\uB294 \uAC74\uC9C0,
      \uB2E4\uB978 \uC77C\uB3C4 \uC0DD\uAE30\uB294 \uAC74\uC9C0 \uAD81\uAE08\uD574\uC694.
      \uAE08\uC9C0\uB41C \uB9D0 \uD574 \uBCF4\uC2E0 \uBD84 \uC788\uB098\uC694?</link>\n\n\uB313\uAE00\n\uC9C0\uB098\uAC00\uB358\uBC24
      : \uC800\uB3C4 \uADF8 \uC0AC\uC774\uD2B8 \uAC00\uBD24\uB294\uB370 \uADF8\uB0E5
      \uBB50 \uC774\uC0C1\uD55C \uC5BC\uAD74 \uB72C\uB2E4 \uD588\uB358 \uAC70 \uAC19\uC544\uC694.\n\nseoyeon041
      [\uC791\uC131\uC790] : \uC624\uB298 \uCE5C\uAD6C\uD55C\uD14C \uD574\uBCF4\uACE0
      \uC54C\uB824\uB4DC\uB9BC \u314B\u314B\n  \u21B3 \uC0C8\uBCBD\uB208\uD305 :
      \uADF8\uB798\uC11C \uC5B4\uCF00\uB428?"
    searchTerms:
    - "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220"
    openDialogueSceneId: Explore_ClientPostOpened
    button: {fileID: 1796488704}
