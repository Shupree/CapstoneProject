  embeddedClientCard: {fileID: 1470247923}
  connectingLabel: {fileID: 304595777}
  connectedControls: {fileID: 960432440}
  callConnectSeconds: 2
  embeddedWindowDrag: {fileID: 734336940}
  openingMessages:
  - {fileID: 1946653961}
  - {fileID: 1859456037}
  - {fileID: 1939887909}
  openingMessageGap: 0.7
  siteEntries:
  - category: "\uAD34\uB2F4 \uBE14\uB85C\uADF8"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uC774\uC57C\uAE30"
    summary: "\uC544\uC774\uB97C \uC783\uC740 \uBA54\uB9AC\uC758 \uC0AC\uC5F0\uACFC
      \uADF8\uB140\uB97C \uC9C4\uC815\uC2DC\uD0A4\uB294 \uB9D0"
    article: "\uC791\uC131\uC790 : \uAD34\uB2F4\uB808\uC2A4\uD1A0\uB791\n\n\uC5EC\uB7EC\uBD84\uB4E4,
      '\uBE14\uB7EC\uB514 \uBA54\uB9AC' \uC774\uC57C\uAE30 \uB4E4\uC5B4\uBCF4\uC168\uB098\uC694?\n\n\uD55C\uBC24\uC911\uC5D0
      \uC774\uB984\uC744 \uC138 \uBC88 \uBD80\uB974\uBA74 \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0B8\uB2E4\uB294
      \uC5EC\uC790. \uBBF8\uB798\uC758 \uBC30\uC6B0\uC790\uB97C \uBCF4\uC5EC\uC900\uB2E4\uB294
      \uC774\uC57C\uAE30\uB85C \uC811\uD55C \uBD84\uB4E4\uB3C4 \uC788\uC744 \uD150\uB370\uC694.
      \uC624\uB298\uC740 \uADF8\uB140\uAC00 \uC65C \uC0AC\uB78C\uB4E4 \uC55E\uC5D0
      \uB098\uD0C0\uB098\uB294\uC9C0, \uADF8 \uC0AC\uC5F0\uC744 \uC18C\uAC1C\uD574
      \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.\n\n\uBA54\uB9AC\uB294 \uC544\uC774\uB97C
      \uC783\uC740 \uC5EC\uC790\uC600\uB2E4\uACE0 \uD569\uB2C8\uB2E4. \uC544\uC774\uB97C
      \uCC3E\uC9C0 \uBABB\uD55C \uCC44 \uC8FD\uC74C\uC744 \uB9DE\uC558\uACE0, \uC8FD\uC5B4\uC11C\uB3C4
      \uADF8 \uC0AC\uC2E4\uC744 \uBC1B\uC544\uB4E4\uC774\uC9C0 \uBABB\uD574 \uC6D0\uD63C\uC774
      \uB418\uC5C8\uB2E4\uACE0 \uD558\uC8E0. \uB204\uAD70\uAC00 \uC774\uB984\uC744
      \uBD80\uB974\uBA74 \uB098\uD0C0\uB098\uB294 \uAC83\uB3C4, \uD639\uC2DC \uADF8
      \uC0AC\uB78C\uC774 \uC544\uC774\uC758 \uD589\uBC29\uC744 \uC54C\uACE0 \uC788\uC744\uAE4C
      \uC2F6\uC5B4\uC11C\uB77C\uB294 \uC774\uC57C\uAE30\uAC00 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uADF8\uB798\uC11C
      \uBA54\uB9AC\uC5D0 \uAD00\uD55C \uC774\uC57C\uAE30\uC5D0\uB294 \uC544\uC774\uB97C
      \uCC3E\uB294 \uB9D0\uACFC \uC544\uC774\uB97C \uBE7C\uC557\uACBC\uB2E4\uB294
      \uBD84\uB178\uAC00 \uD568\uAED8 \uB4F1\uC7A5\uD569\uB2C8\uB2E4. \uB204\uAD70\uAC00\uB294
      \uADF8\uB140\uC5D0\uAC8C \uBBF8\uB798\uB97C \uBB3B\uC9C0\uB9CC, \uC815\uC791
      \uBA54\uB9AC\uAC00 \uAE30\uB2E4\uB9AC\uB294 \uAC83\uC740 \uC790\uAE30 \uC544\uC774\uC5D0
      \uB300\uD55C \uB300\uB2F5\uC77C\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4.\n\n\uC804\uD574\uC9C0\uB294
      \uC774\uC57C\uAE30\uC5D0\uB294 \uBA54\uB9AC\uB97C \uC9C4\uC815\uC2DC\uD0A4\uB294
      \uB9D0\uB3C4 \uB0A8\uC544 \uC788\uC2B5\uB2C8\uB2E4.\n\n<link=\"mary_weakness\"><b>\u201C\uB124
      \uC544\uC774\uB294 \uC8FD\uC9C0 \uC54A\uC558\uC5B4.\u201D</b></link>\n\n\uC544\uC774\uB97C
      \uC783\uC5C8\uB2E4\uB294 \uC2AC\uD514\uACFC \uC6D0\uD55C\uC5D0 \uC0AC\uB85C\uC7A1\uD78C
      \uBA54\uB9AC\uC5D0\uAC8C, \uC544\uC774\uAC00 \uC8FD\uC9C0 \uC54A\uC558\uB2E4\uACE0
      \uC54C\uB824\uC8FC\uB294 \uAC83\uC785\uB2C8\uB2E4. \uC774 \uB9D0\uC744 \uB4E4\uC73C\uBA74
      \uBA54\uB9AC\uAC00 \uC0C1\uB300\uB97C \uD5A5\uD558\uB358 \uBD84\uB178\uB97C
      \uAC70\uB450\uACE0 \uADC0\uB97C \uAE30\uC6B8\uC778\uB2E4\uACE0 \uD558\uC8E0.\n\n\uC544\uC774\uC758
      \uC0DD\uC0AC\uAC00 \uC2E4\uC81C\uB85C \uC5B4\uB5BB\uAC8C \uB418\uC5C8\uB294\uC9C0\uB294
      \uC774\uC57C\uAE30\uB9C8\uB2E4 \uBD84\uBA85\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uB2E4\uB9CC \uBA54\uB9AC\uB97C \uB2EC\uB798\uB294 \uB9D0\uB85C \uC774 \uBB38\uC7A5\uC774
      \uBC18\uBCF5\uD574\uC11C \uC804\uD574\uC9C4\uB2E4\uB294 \uC810\uC740 \uB208\uC5EC\uACA8\uBCFC
      \uB9CC\uD569\uB2C8\uB2E4.\n\n\uC624\uB298 \uC54C\uC544\uBCF8 \uBA54\uB9AC \uC774\uC57C\uAE30,
      \uC5B4\uB5A0\uC168\uB098\uC694? \uBBF8\uB798\uC758 \uBC30\uC6B0\uC790\uB97C
      \uBCF4\uC5EC\uC900\uB2E4\uB294 \uC18C\uBB38\uB9CC \uC54C\uACE0 \uACC4\uC168\uB2E4\uBA74,
      \uADF8 \uB4A4\uC5D0 \uC774\uB7F0 \uC0AC\uC5F0\uB3C4 \uC788\uB2E4\uB294 \uAC83\uC744
      \uAE30\uC5B5\uD574 \uC8FC\uC138\uC694.\n\n<b>\uB313\uAE00</b>\n\uBC24\uC0B0\uCC45
      : \uBC30\uC6B0\uC790 \uBCF4\uC5EC\uC8FC\uB294 \uADC0\uC2E0\uC778 \uC904\uB9CC
      \uC54C\uC558\uB294\uB370 \uC0AC\uC5F0\uC740 \uC2AC\uD504\uB124\uC694.\n\uC720\uB9AC\uC794
      : \uADF8\uB798\uC11C \uC544\uC774 \uC774\uC57C\uAE30\uAC00 \uACC4\uC18D \uB098\uC624\uB294
      \uAC70\uC600\uAD6C\uB098.\n\uAC10\uC790\uC218\uD504 : \uC55E\uC5D0 \uAC70\uC6B8
      \uC0AC\uC9C4 \uB54C\uBB38\uC5D0 \uD654\uBA74 \uB0B4\uB9AC\uB2E4\uAC00 \uC81C
      \uC5BC\uAD74 \uBCF4\uACE0 \uB180\uB790\uC5B4\uC694;\n\uAD34\uB2F4\uC218\uC9D1\uC911
      : \uC774\uB7F0 \uBC30\uACBD \uC774\uC57C\uAE30 \uC88B\uC544\uC694. \uB2E4\uC74C
      \uAE00\uB3C4 \uAE30\uB2E4\uB9B4\uAC8C\uC694."
    button: {fileID: 1369764134}
  - category: "\uAC15\uB839\uC220 \uC548\uB0B4"
    title: "\uBBF8\uB798\uC758 \uC544\uB0B4/\uB0A8\uD3B8\uC744 \uC54C \uC218 \uC788\uB294
      \uAC15\uB839\uC220!"
    summary: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220 PC \uBC84\uC804\uC758
      \uC9C4\uD589 \uBC29\uBC95\uACFC \uC8FC\uC758\uC0AC\uD56D"
    article: "\uC791\uC131\uC790 : \uC0DD\uD65C\uAC15\uB839\n\n\uC194\uB85C\uC778
      \uC0AC\uB78C\uB4E4 \uD544\uB3C5! <link=\"mary_spouse\">\uBBF8\uB798\uC758 \uBC30\uC6B0\uC790\uB97C
      \uC54C \uC218 \uC788\uB294 \uBC29\uBC95!!</link>\n\n\uC624\uB298 \uC18C\uAC1C\uD560
      \uAC83\uC740 \uBE14\uB7EC\uB514 \uBA54\uB9AC \uAC15\uB839\uC220 PC \uBC84\uC804\uC785\uB2C8\uB2E4.
      \uAC70\uC6B8 \uC55E\uC5D0 \uC11C\uB294 \uB300\uC2E0 \uCEA0\uC744 \uC5F0\uACB0\uD574\uC11C
      \uC9C4\uD589\uD558\uB294 \uBC29\uC2DD\uC774\uC5D0\uC694. \uB204\uAD6C\uC640
      \uACB0\uD63C\uD558\uAC8C \uB420\uC9C0 \uAD81\uAE08\uD558\uC168\uB2E4\uBA74
      \uC544\uB798 \uC21C\uC11C\uB97C \uCC28\uB840\uB300\uB85C \uC77D\uC5B4 \uC8FC\uC138\uC694.\n\n<b>\u25A0
      \uC900\uBE44\uD560 \uAC83</b>\n\n\uCEA0\uC774 \uC5F0\uACB0\uB41C \uCEF4\uD4E8\uD130,
      \uD654\uC0C1 \uD1B5\uD654 \uD504\uB85C\uADF8\uB7A8, \uADF8\uB9AC\uACE0 \uBC24
      12\uC2DC\uAE4C\uC9C0 \uAE30\uB2E4\uB9B4 \uC5EC\uC720!\n\n<b>\u25A0 \uC9C4\uD589
      \uBC29\uBC95</b>\n\n1. \uBC24 12\uC2DC\uC5D0 \uCEA0\uC744 \uC5F0\uACB0\uD558\uACE0
      \uBE14\uB7EC\uB514 \uBA54\uB9AC \uC0AC\uC774\uD2B8\uC5D0 \uC811\uC18D\uD569\uB2C8\uB2E4.\n\n\uC0AC\uC774\uD2B8\uC5D0
      \uB4E4\uC5B4\uAC00\uBA74 \uC790\uC2E0\uC758 \uCEA0 \uC601\uC0C1\uC774 \uD654\uBA74\uC5D0
      \uB098\uD0C0\uB0A9\uB2C8\uB2E4. \uB2E4\uB978 \uC0AC\uB78C\uACFC \uC5F0\uACB0\uB418\uB294
      \uC77C\uBC18\uC801\uC778 \uD654\uC0C1\uD1B5\uD654 \uD654\uBA74\uACFC\uB294
      \uB2EC\uB77C\uC694. \uCC98\uC74C\uC5D0 \uC790\uAE30 \uC5BC\uAD74\uB9CC \uBCF4\uC778\uB2E4\uACE0
      \uC798\uBABB \uB4E4\uC5B4\uAC04 \uAC83\uC774 \uC544\uB2D9\uB2C8\uB2E4.\n\n2.
      \uD654\uBA74\uC744 \uBCF4\uBA70 \u2018\uBE14\uB7EC\uB514 \uBA54\uB9AC\u2019\uB97C
      \uC138 \uBC88 \uC678\uCE69\uB2C8\uB2E4.\n\n\uBE14\uB7EC\uB514 \uBA54\uB9AC.
      \uBE14\uB7EC\uB514 \uBA54\uB9AC. \uBE14\uB7EC\uB514 \uBA54\uB9AC.\n\n3. \uD654\uBA74\uC5D0
      \uBA54\uB9AC\uAC00 \uB098\uD0C0\uB098\uBA74 \uBBF8\uB798\uC758 \uBC30\uC6B0\uC790\uB97C
      \uBB3C\uC5B4\uBD05\uB2C8\uB2E4.\n\n\uC5EC\uAE30\uAE4C\uC9C0\uAC00 \uAE30\uBCF8\uC801\uC778
      \uC9C4\uD589 \uBC29\uBC95\uC785\uB2C8\uB2E4. \uC774\uB984\uC744 \uBD80\uB974\uAE30
      \uC804\uC5D0 \uC544\uB798 \uC8FC\uC758\uC0AC\uD56D\uAE4C\uC9C0 \uAF2D \uC77D\uC5B4
      \uC8FC\uC138\uC694!\n\n<b>\u25A0 \uC8FC\uC758\uC0AC\uD56D</b>\n\n<link=\"mary_weapon\"><b>1.
      \uCE7C\uC744 \uB4E0 \uBA54\uB9AC\uAC00 \uB098\uD0C0\uB09C\uB2E4\uBA74 \uC989\uC2DC
      \uD1B5\uD654\uB97C \uC885\uB8CC\uD560 \uAC83.</b></link>\n\n\uBA54\uB9AC\uAC00
      \uB098\uD0C0\uB0AC\uB2E4\uACE0 \uBC14\uB85C \uC9C8\uBB38\uD558\uC9C0 \uB9D0\uACE0,
      \uC190\uC5D0 \uBB34\uC5C7\uC744 \uB4E4\uACE0 \uC788\uB294\uC9C0 \uBA3C\uC800
      \uD655\uC778\uD558\uC138\uC694. \uCE7C\uC774 \uBCF4\uC778\uB2E4\uBA74 \uBC30\uC6B0\uC790\uB97C
      \uBB3C\uC5B4\uBCF4\uC9C0 \uB9D0\uACE0 \uD1B5\uD654 \uC885\uB8CC \uBC84\uD2BC\uC744
      \uB204\uB974\uC138\uC694.\n\n<link=\"mary_forbidden\"><b>2. \u2018\uB124 \uC544\uC774\uB294
      \uB0B4\uAC00 \uC8FD\uC600\uC5B4\u2019\uB77C\uB294 \uB9D0\uC744 \uD558\uC9C0
      \uB9D0 \uAC83.</b></link>\n<vision><color=#C31D1D><link=\"mary_curse\">\uBA54\uB9AC\uAC00    
      \uB2F9\uC2E0\uC744     \uBD99\uC7A1\uC2B5\uB2C8\uB2E4</link></color></vision>\n\n\uC774
      \uB9D0\uC744 \uD558\uBA74 \uC774\uC0C1\uD55C \uD654\uBA74\uACFC \uC18C\uB9AC\uAC00
      \uB098\uC624\uB2C8 \uC8FC\uC758\uD558\uC138\uC694. \uAC19\uC774 \uD558\uB294
      \uCE5C\uAD6C\uB97C \uB180\uB798\uD0A4\uACA0\uB2E4\uACE0 \uC7A5\uB09C\uC73C\uB85C
      \uC678\uCE58\uC9C0 \uB9C8\uC138\uC694!\n\n\uAD81\uAE08\uD55C \uC810\uC774\uB098
      \uD6C4\uAE30\uB294 \uB313\uAE00\uB85C \uB0A8\uACA8 \uC8FC\uC138\uC694. \uBC30\uC6B0\uC790\uB97C
      \uBCF4\uC168\uB2E4\uB294 \uBD84\uB4E4\uC740 \uC5B4\uB5A4 \uC0AC\uB78C\uC774\uC5C8\uB294\uC9C0\uB3C4
      \uC0B4\uC9DD \uC54C\uB824\uC8FC\uC2DC\uACE0\uC694 :)\n\n<b>\uB313\uAE00</b>\n\uB0B4\uC9DD\uC5B4\uB528\uB2C8
      : \uC900\uBE44\uBB3C\uC740 \uB2E4 \uC788\uB294\uB370 12\uC2DC\uAE4C\uC9C0 \uBC84\uD2F0\uB294
      \uAC8C \uC81C\uC77C \uC5B4\uB835\uB124...\n<link=\"mary_comment\">seoyeon041
      : \uC800 \uC774\uC0C1\uD55C \uD654\uBA74\uC774\uB791 \uC18C\uB9AC \uB098\uC624\uB294
      \uAC70\uC694. \uC800 \uB9D0 \uD55C \uC0AC\uB78C\uC774 \uC544\uB2C8\uB77C \uBC30\uC6B0\uC790
      \uCC3E\uAE30 \uD558\uB294 \uC0AC\uB78C\uD55C\uD14C \uB098\uC624\uB294 \uAC70\uC8E0?</link>\n\uBAA8\uB2C8\uD130\uBA3C\uC9C0
      : \uC8FC\uC758\uC0AC\uD56D \uC77D\uB2E4\uAC00 \uBC30\uC6B0\uC790 \uC548 \uAD81\uAE08\uD574\uC84C\uC5B4\uC694.\n\uC0DD\uD65C\uAC15\uB839
      : \uC9C8\uBB38\uC774 \uB9CE\uC544\uC11C \uB367\uBD99\uC785\uB2C8\uB2E4. \uC0AC\uC774\uD2B8\uC5D0
      \uCC98\uC74C \uB4E4\uC5B4\uAC14\uC744 \uB54C \uC790\uAE30 \uC5BC\uAD74\uC774
      \uB098\uC624\uB294 \uAC74 \uC815\uC0C1\uC774\uC5D0\uC694!\n\uC0C8\uBCBD\uB450\uC2DC
      : \uD6C4\uAE30 \uBCF4\uB7EC \uC654\uB294\uB370 \uB2E4\uB4E4 \uC9C8\uBB38\uB9CC
      \uD558\uACE0 \uC788\uC5B4\u314B\u314B\u314B"
    button: {fileID: 478300121}
  - category: "\uBE14\uB85C\uADF8"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC (\uBBF8\uAD6D\uAD34\uB2F4)"
    summary: "\uBA54\uB9AC\uB97C \uC18C\uD658\uD574 \uB098\uD0C0\uB098\uAC8C \uB418\uBA74
      \uC790\uC2E0\uC744 \uBD80\uB978 \uC0AC\uB78C\uC744 \uC8FD\uC778\uB2E4\uACE0
      \uD569\uB2C8\uB2E4."
    article: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAD00\uB828 \uAE30\uB85D\uACFC \uACBD\uD5D8\uC744
      \uACF5\uC720\uD55C \uAE00\uC774\uB2E4.\n\n\uAC15\uB839\uC220\uC5D0 \uC131\uACF5\uD588\uB2E4\uB294
      \uB9D0\uB3C4 \uC788\uC9C0\uB9CC \uD655\uC778\uD560 \uC790\uB8CC\uB294 \uC5C6\uB2E4.
      \uB313\uAE00\uC5D0\uC11C\uB294 \uC774\uB7F0 \uAC78 \uBBFF\uB0D0\uAC70\uB098
      \uC2E4\uC81C\uB85C \uD574 \uBCF8 \uC0AC\uB78C\uC774 \uC788\uB0D0\uACE0 \uBB3B\uB294\uB2E4."
    button: {fileID: 627332760}
  - category: "\uB3C4\uC2DC\uC804\uC124 \uC544\uCE74\uC774\uBE0C"
    title: "\uAC70\uC6B8 \uC18D \uC774\uB984\uC744 \uBD80\uB974\uB294 \uC758\uC2DD"
    summary: "\uCD1B\uBD88\uACFC \uAC70\uC6B8\uC744 \uC0AC\uC6A9\uD558\uB294 \uAC15\uB839\uD68C\uC5D0
      \uB300\uD55C \uAE30\uB85D"
    article: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAD00\uB828 \uAE30\uB85D\uACFC \uACBD\uD5D8\uC744
      \uACF5\uC720\uD55C \uAE00\uC774\uB2E4.\n\n\uAC15\uB839\uC220\uC5D0 \uC131\uACF5\uD588\uB2E4\uB294
      \uB9D0\uB3C4 \uC788\uC9C0\uB9CC \uD655\uC778\uD560 \uC790\uB8CC\uB294 \uC5C6\uB2E4.
      \uB313\uAE00\uC5D0\uC11C\uB294 \uC774\uB7F0 \uAC78 \uBBFF\uB0D0\uAC70\uB098
      \uC2E4\uC81C\uB85C \uD574 \uBCF8 \uC0AC\uB78C\uC774 \uC788\uB0D0\uACE0 \uBB3B\uB294\uB2E4."
    button: {fileID: 193249308}
  - category: "\uAD34\uB2F4 \uAC8C\uC2DC\uD310"
    title: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uACBD\uD5D8\uB2F4"
    summary: "\uC758\uC2DD\uC744 \uD55C \uB4A4 \uC774\uC0C1\uD55C \uC77C\uC744 \uACAA\uC5C8\uB2E4\uB294
      \uC774\uC57C\uAE30"
    article: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAD00\uB828 \uAE30\uB85D\uACFC \uACBD\uD5D8\uC744
      \uACF5\uC720\uD55C \uAE00\uC774\uB2E4.\n\n\uAC15\uB839\uC220\uC5D0 \uC131\uACF5\uD588\uB2E4\uB294
      \uB9D0\uB3C4 \uC788\uC9C0\uB9CC \uD655\uC778\uD560 \uC790\uB8CC\uB294 \uC5C6\uB2E4.
      \uB313\uAE00\uC5D0\uC11C\uB294 \uC774\uB7F0 \uAC78 \uBBFF\uB0D0\uAC70\uB098
      \uC2E4\uC81C\uB85C \uD574 \uBCF8 \uC0AC\uB78C\uC774 \uC788\uB0D0\uACE0 \uBB3B\uB294\uB2E4."
    button: {fileID: 600308813}
  - category: "\uAD34\uB2F4 \uC704\uD0A4"
    title: "\uAC70\uC6B8 \uAD34\uB2F4\uC758 \uC9C0\uC5ED\uBCC4 \uC804\uC2B9"
    summary: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uC774\uC57C\uAE30\uC758 \uB2E4\uB978
      \uD615\uD0DC\uB97C \uC815\uB9AC\uD588\uC2B5\uB2C8\uB2E4."
    article: "\uBE14\uB7EC\uB514 \uBA54\uB9AC \uAD00\uB828 \uAE30\uB85D\uACFC \uACBD\uD5D8\uC744
      \uACF5\uC720\uD55C \uAE00\uC774\uB2E4.\n\n\uAC15\uB839\uC220\uC5D0 \uC131\uACF5\uD588\uB2E4\uB294
      \uB9D0\uB3C4 \uC788\uC9C0\uB9CC \uD655\uC778\uD560 \uC790\uB8CC\uB294 \uC5C6\uB2E4.
      \uB313\uAE00\uC5D0\uC11C\uB294 \uC774\uB7F0 \uAC78 \uBBFF\uB0D0\uAC70\uB098
