  m_Script: {fileID: 11500000, guid: 873c4654df8df264496dfde70f56cc52, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BattleProtoConversation
  messenger: {fileID: 952980673}
  preparationMessages:
  - {fileID: 1901530480}
  - {fileID: 355595507}
  - {fileID: 838261429}
  startCallButton: {fileID: 1828225183}
  groupCallWindow: {fileID: 878428650}
  callLines:
  - speaker: "\uC720\uBBF8\uB098"
    text: "\uC900\uBE44\uB418\uC168\uB098\uC694?"
    playProgrammingAfter: 0
    heroineSprite: {fileID: -1587681010093017276, guid: 40e472643562b5847aaf89d2224dc0db, type: 3}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC774\uC11C\uC5F0"
    text: "\uB124.. \uC900\uBE44\uB410\uC5B4\uC694."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC720\uBBF8\uB098"
    text: "\uADF8\uB7FC \uC2DC\uC791\uD574\uBCF4\uC8E0."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC720\uBBF8\uB098, \uC774\uC11C\uC5F0"
    text: "\uBE14\uB7EC\uB514 \uBA54\uB9AC, \uBE14\uB7EC\uB514 \uBA54\uB9AC, \uBE14\uB7EC\uB514
      \uBA54\uB9AC..."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: 
    text: "\uAC15\uB839\uC220 \uB0B4\uC6A9\uB300\uB85C, \uBE14\uB7EC\uB514 \uBA54\uB9AC\uB97C
      \uC138 \uBC88 \uC678\uCCE4\uB2E4."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: 
    text: "\uADF8\uB7EC\uB098, \uC544\uBB34\uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0
      \uC54A\uC558\uB2E4."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC720\uBBF8\uB098"
    text: "\uC74C... \uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uB124\uC694... "
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC720\uBBF8\uB098"
    text: "\uBB34\uC5B8\uAC00 \uC798\uBABB\uD55C \uBD80\uBD84\uC774 \uC788\uC5C8\uB098..?"
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC774\uC11C\uC5F0"
    text: ...
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC720\uBBF8\uB098"
    text: "...\uC11C\uC5F0 \uC528?"
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: 
    text: "\uC774\uC11C\uC5F0\uC740 \uB300\uB2F5\uC774 \uC5C6\uC5C8\uB2E4."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: 
    text: "\uB610\uD55C, \uC6C0\uC9C1\uC784\uB3C4 \uC5C6\uC5C8\uB2E4."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: 
    text: "\uADF8\uB9AC\uACE0..."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
