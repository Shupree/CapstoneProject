--- !u!114 &952980675
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 952980671}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 873c4654df8df264496dfde70f56cc52, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BattleProtoConversation
  messenger: {fileID: 952980673}
  preparationMessages:
  - {fileID: 1901530480}
  - {fileID: 355595507}
  - {fileID: 838261429}
  startCallButton: {fileID: 1828225183}
  groupCallWindow: {fileID: 878428650}
  callLines:
  - speaker: "\uCE5C\uAD6C"
    text: "\uC548\uB155\uD558\uC138\uC694.. \uB4E4\uB9AC\uC138\uC694..?"
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uB124 \uC798 \uB4E4\uB824\uC694! \uB2E4\uD589\uC774\uB124\uC694~"
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uCE5C\uAD6C"
    text: "\uC800.. \uB3CC\uC544\uAC08 \uC218 \uC788\uB294 \uAC70\uC8E0?"
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uADF8\uB7FC\uC694! \uC81C\uAC00 \uAF2D \uD574\uB0BC\uAC70\uC5D0\uC694!"
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC2DC\uC728"
    text: "\uD1F4\uB9C8\uC0AC\uB2D8, \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694!"
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uBA3C\uC800, \uD504\uB85C\uADF8\uB7A8\uC744 \uD1B5\uD574\uC11C \uBE14\uB7EC\uB514\uBA54\uB9AC\uB97C
      \uCE5C\uAD6C\uBD84\uC5D0\uAC8C\uC11C \uBD84\uB9AC\uD560 \uAC70\uC5D0\uC694."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC544\uD508\uC9C0\uB294 \uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC..  \uC870\uAE08\uB9CC
      \uCC38\uC544\uC8FC\uC138\uC694!"
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: 
    text: "\uB098\uB294 \uD504\uB85C\uADF8\uB7A8\uC744 \uC0AC\uC6A9\uD588\uB2E4."
    playProgrammingAfter: 1
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: 
    text: ...
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: 
    text: "\uD558\uC9C0\uB9CC \uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0
      \uC54A\uC558\uB2E4."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: 
    text: "\uBB54\uAC00 \uC798\uBABB\uB410\uB2E4\uACE0 \uC0DD\uAC01\uD55C \uC21C\uAC04.."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uCE5C\uAD6C"
    text: "\uC544\uC544\uC544\uC544\uC544\uC545!!!!!!!!"
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: 
    text: "\uC2DC\uC728\uC758 \uCE5C\uAD6C\uB294 \uAD34\uC131\uC744 \uC9C8\uB800\uB2E4."
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    text: "\uC73D.. \uC8C4\uC1A1\uD574\uC694, \uBE68\uB9AC \uBD84\uB9AC\uC2DC\uCF1C
      \uB4DC\uB9B4\uAC8C\uC694!"
    playProgrammingAfter: 0
    heroineSprite: {fileID: 0}
    clientSprite: {fileID: 0}
    friendSprite: {fileID: 0}
  callSpeaker: {fileID: 190724540}
  callText: {fileID: 1548327558}
