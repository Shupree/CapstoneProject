--- !u!114 &1604848100
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1604848099}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6cf7b0aac20f2a48a2bd96bc08b2a9e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BackgroundConversationController
  segments:
  - label: ch_1_intro_01
    background: {fileID: 2800000, guid: 70015e7d775799a4b84de1c0ff7baa2f, type: 3}
    lines:
    - speaker: "\uC774\uC11C\uC5F0"
      text: "\uC900\uBE44 \uB410\uC5B4?"
      showPortrait: 0
    - speaker: "\uCE5C\uAD6C"
      text: "\uC5B4, \uC751!"
      showPortrait: 0
    - speaker: "\uCE5C\uAD6C"
      text: "\uD5E4\uD5E4.. \uBBF8\uB798\uC758 \uB0B4 \uB0A8\uD3B8\uC740 \uB204\uAD6C\uC77C\uAE4C.."
      showPortrait: 0
    - speaker: "\uC774\uC11C\uC5F0"
      text: "\uADF8\uB7FC \uC2DC\uC791\uD574\uBCF4\uC790."
      showPortrait: 0
    useDialogueBox: 0
    fadeThroughBlackAfter: 0
  - label: ch_1_intro_02
    background: {fileID: 2800000, guid: 0ead1c7c4bdc73745be7319f4742f5cf, type: 3}
    lines:
    - speaker: "\uCE5C\uAD6C"
      text: "\uBE14\uB7EC\uB514\uBA54\uB9AC, \uBE14\uB7EC\uB514\uBA54\uB9AC, \uBE14\uB7EC\uB514\uBA54\uB9AC.."
      showPortrait: 0
    - speaker: "\uC774\uC11C\uC5F0"
      text: "\u3141 \u3141\u3141\u3141 \u3141\u3141 \u3141\u3141\u3141"
      showPortrait: 0
    useDialogueBox: 0
    fadeThroughBlackAfter: 0
  - label: ch_1_intro_03
    background: {fileID: 2800000, guid: a054c6d7776b9954196cdefcb2b15f72, type: 3}
    lines:
    - speaker: "\uCE5C\uAD6C"
      text: "\uAE84\uC544\uC544\uC544\uC545!!!!!!"
      showPortrait: 0
    useDialogueBox: 0
    fadeThroughBlackAfter: 0
  - label: ch_1_intro_04
    background: {fileID: 2800000, guid: 85bbdf38c82b4b34583974c3bffba9b2, type: 3}
    lines:
    - speaker: "\uCE5C\uAD6C"
      text: "\uC774\uAC70 \uBB50\uC57C? \uB194!! \uB193\uC73C\uB77C\uACE0!!!"
      showPortrait: 0
    - speaker: "\uCE5C\uAD6C"
      text: "\uB193\uC73C...\uB77C..."
      showPortrait: 0
    useDialogueBox: 0
    fadeThroughBlackAfter: 0
  - label: ch_1_intro_05
    background: {fileID: 2800000, guid: 49d2b923dfb52c3449683d35c270564c, type: 3}
    lines:
    - speaker: "\uC774\uC11C\uC5F0"
      text: "\uC5B4... \uC5B4...?"
      showPortrait: 0
    - speaker: "\uC774\uC11C\uC5F0"
      text: "\uB300\uCCB4... \uC65C...?"
      showPortrait: 0
    useDialogueBox: 0
    fadeThroughBlackAfter: 1
  - label: ch_1_intro2_01
    background: {fileID: 2800000, guid: ede657e5e66d8024b9227d81dbe9de48, type: 3}
    lines:
    - speaker: "\uC720\uBBF8\uB098"
      text: "\uC73C\uC74F~~ \uCC28. \uBC8C\uC368 \uC544\uCE68\uC774\uB124?"
      showPortrait: 0
    - speaker: "\uB098\uB808\uC774\uC158"
      text: "\uB098\uB294 \uC7A0\uC5D0\uC11C \uAE68\uC5B4\uB098 \uAE30\uC9C0\uAC1C\uB97C
        \uCF30\uB2E4. \uC804 \uB0A0 \uCC45\uC0C1\uC5D0\uC11C \uC7A0\uB4E4\uC5C8\uB294\uC9C0,
        \uC628 \uBAB8\uC774 \uC464\uC168\uB2E4."
      showPortrait: 0
    - speaker: "\uC720\uBBF8\uB098"
      text: "\uC73C\uC73C, \uBAA9\uC774\uC57C. \uCE68\uB300\uB294 \uB480\uB2E4 \uBB50
        \uD558\uB294 \uAC70\uB78C."
      showPortrait: 0
    useDialogueBox: 1
    fadeThroughBlackAfter: 0
  - label: ch_1_intro2_02
    background: {fileID: 2800000, guid: c1d73c06246731b419d7a995b89b2daa, type: 3}
    lines:
    - speaker: "\uB098\uB808\uC774\uC158"
      text: "\uB098\uB294 \uC778\uD130\uB137\uC758 \uC2EC\uB839\uD604\uC0C1\uC744
        \uACE0\uCE58\uB294 \uC77C\uC744 \uD558\uACE0 \uC788\uB2E4. \uB0B4 \uBA4B\uB300\uB85C
        \u2018\uC0AC\uC774\uBC84 \uD1F4\uB9C8\uC0AC\u2019\uB77C\uB294 \uC774\uB984\uC744
        \uBD99\uC600\uB2E4."
      showPortrait: 0
    - speaker: "\uB098\uB808\uC774\uC158"
      text: "\uAC1C\uBC1C\uC790 \uD558\uB358 \uC19C\uC528\uB85C \uD1F4\uB9C8 \uD504\uB85C\uADF8\uB7A8\uC744
        \uB9CC\uB4E4\uC5C8\uB294\uB370, \uC790\uC798\uD55C \uC758\uB8B0\uB4E4\uC740
        \uBC8C\uC368 \uBA87 \uBC88 \uD574\uACB0\uD588\uB2E4."
      showPortrait: 0
    - speaker: "\uB098\uB808\uC774\uC158"
      text: "\uBB50, \uB3C8\uC744 \uB9CE\uC774 \uBC84\uB294 \uAC83\uB3C4 \uC544\uB2C8\uACE0,
        \uC5B4\uB514 \uBB3C\uC5B4\uBCFC\uB9CC\uD55C \uACF3\uB3C4 \uC5C6\uC9C0\uB9CC..."
      showPortrait: 0
    - speaker: "\uB098\uB808\uC774\uC158"
      text: "...\uD1F4\uB9C8 \uC77C\uC744 \uD560 \uC218 \uC788\uC5B4\uC11C \uC88B\uB2E4."
      showPortrait: 0
    - speaker: "\uC720\uBBF8\uB098"
      text: "\uC74C! \uADF8\uB7FC \uC624\uB298\uB3C4 \uD798\uCC28\uAC8C \uC2DC\uC791\uD574\uBCFC\uAE4C?"
      showPortrait: 1
    - speaker: "\uB098\uB808\uC774\uC158"
      text: "\uB098\uB294 \uC758\uC790\uB97C \uB2F9\uACA8 \uC549\uACE0, \uBAA8\uB2C8\uD130\uB97C
        \uCF30\uB2E4."
      showPortrait: 1
    useDialogueBox: 1
    fadeThroughBlackAfter: 0
  backgroundImage: {fileID: 1928182295}
  backgroundAspect: {fileID: 1928182292}
  transitionImage: {fileID: 2087226356}
  transitionAspect: {fileID: 2087226353}
